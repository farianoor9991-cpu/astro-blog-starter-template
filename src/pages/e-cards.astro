---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import DesignGrid from '../components/DesignGrid.astro';
import OccasionChips from '../components/OccasionChips.astro';

// Ticker text for this page: edit these lines to change what scrolls at the top
const ticker = [
	'✨ Digital E-Cards',
	'⚡ Instant Downloads',
	'💍 Wedding · Nikkah · Mayun · Mehndi · Baraat · Walima · Birthday · Hajj/Umrah · Aqeeqah · Baby Announcements',
	'📲 Customization Available',
];
---

<PageLayout
	title="E-Cards | Invite Heaven"
	description="Elegant digital e-cards for weddings and celebrations, personalized with your details and ready to share on WhatsApp."
	ticker={ticker}
	section="ecards"
	variant="home"
>
	<Hero
		heading='Digital E-Cards <br class="laptop-br" />For Your Memorable <br class="laptop-br" />Day!'
		text="Beautifully designed e-cards, personalized with your names, date, and venue, and ready to share on WhatsApp within minutes."
		buttonLabel="Browse E-Cards"
		buttonHref="#ecard"
		image="/hero-phone.jpg"
		imageAlt="Floral wedding e-card shown on a phone"
	/>


	<DesignGrid
		type="ecard"
		limit={8}
		moreHref="/e-cards/catalogue"
		secondHref="/"
		secondLabel="Our Signature Website Invitations"
	>
		<div slot="filters">
			<OccasionChips type="ecard" href="/e-cards/catalogue" />
		</div>
	</DesignGrid>
</PageLayout>
