	.st { display: flex; align-items: center; gap: 14px; background: #fff; border: 1px solid #EFE3CC; border-radius: 16px; padding: 16px 18px; min-width: 0; box-shadow: 0 1px 3px rgba(120, 90, 50, 0.06); }
