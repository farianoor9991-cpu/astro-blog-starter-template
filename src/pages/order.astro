	.nv-tog { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 8px; background: #F7EEDF; border: 1px solid #EBD9BC; border-radius: 12px; padding: 12px 14px; font: 600 14px 'Poppins', sans-serif; color: #1A1A1A; cursor: pointer; margin-bottom: 8px; }
	.nv-i { display: flex; align-items: center; gap: 11px; width: 100%; text-align: left; background: transparent; border: 0; border-radius: 12px; padding: 11px 12px; font: 500 14px 'Poppins', sans-serif; color: #5A5A5A; cursor: pointer; line-height: 1.3; }
	.nv-i:hover { background: #F7EEDF; color: #1A1A1A; }
