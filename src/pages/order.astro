	.tb-row { border-bottom: 1px solid #F0E6D2; }
	.tb-row:last-child { border-bottom: 0; }
	.tb-row:nth-child(even) { background: #FDFAF3; }
	.tb-row:hover { background: #FAF3E6; }
	.tb-c { padding: 10px; border-right: 1px solid #F3EAD8; min-width: 0; display: flex; align-items: center; }
	.tb-c:last-child { border-right: 0; }
	.tb-name { gap: 8px; }
	.tb-name > b { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 700; color: #1A1A1A; display: block; }
	.tb-g .tb-name { flex-direction: column; align-items: flex-start; justify-content: center; gap: 3px; }
	.tb-name small { display: block; color: #7a6a58; font-size: 12px; line-height: 1.4; }
	.tb-name .gn { display: flex; align-items: center; gap: 6px; flex: 1; min-width: 0; position: relative; }
	.tb-name .gn .gtxt { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 700; color: #1A1A1A; line-height: 1.3; overflow-wrap: anywhere; min-width: 0; }
	.tb-name .gn .lbl { display: none; flex: 1; min-width: 0; font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 700; margin: 0; padding: 6px 9px; }
	.tb-name .gn .lbl:not([readonly]) { display: block; border-color: #D4A276; box-shadow: 0 0 0 3px rgba(212, 162, 118, 0.22); outline: none; }
	.tb-name .gn .lbl:not([readonly]) + .gtxt { display: none; }
	.tb-name .gn .pen { position: static; transform: none; flex: 0 0 auto; width: 26px; height: 26px; opacity: 0.75; }
	.rm-i { flex: 0 0 auto; width: 24px; height: 24px; border: 0; border-radius: 50%; background: transparent; color: #b08a84; font-size: 18px; line-height: 1; cursor: pointer; padding: 0; }
	.rm-i:hover { background: #fbe9e7; color: #b3261e; }
