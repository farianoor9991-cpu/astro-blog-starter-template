			for (var i = 1; i < t.length; i++) { if (/^f$/i.test(t[i]) || /^[+\d][\d\-+]*$/.test(t[i])) { cut = i; break; } }
			return t.slice(0, cut).join(' ').replace(/[,|:\-\s]+$/, '').trim();
		}
