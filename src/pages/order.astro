	/* ===== calm, clean look (cream + gold, serif names) ===== */
	.od { --cr: #FBF6EA; --cr2: #F5EAD3; --ln: #EADFC9; --gd: #B8793C; --tx: #3B352D; --mu: #6B6459; }
	.od-content { background: linear-gradient(180deg, #FDFAF2 0%, #FBF5E8 100%); }
	.od-content h2 { font-family: 'Nunito', sans-serif; font-weight: 700; color: #1A1A1A; letter-spacing: 0; }
	.od-sec { background: rgba(255, 255, 255, 0.62); border: 1px solid var(--ln); border-radius: 18px; box-shadow: 0 1px 0 rgba(255,255,255,.8) inset, 0 6px 18px rgba(120, 90, 40, 0.05); }
	.hint { color: var(--mu); }
	.pill { display: inline-block; font: 500 12px 'Nunito', sans-serif; padding: 3px 11px; border-radius: 999px; background: #F3E3C4; color: #7a5a2e; white-space: nowrap; }
	/* guest list: grouped by combination */
	.gr-grp { margin: 0 0 14px; border: 1px solid var(--ln); border-radius: 16px; background: #FFFCF6; overflow: hidden; }
	.gr-gh { display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px 16px; border: 0; background: var(--cr2); cursor: pointer; text-align: left; font: 400 15px 'Nunito', sans-serif; color: var(--tx); }
