	.urlb { display: flex; align-items: center; gap: 7px; width: 100%; min-width: 0; text-align: left; background: #FCF9F1; border: 1px dashed #D9B98F; color: #6b4a22; border-radius: 8px; padding: 8px 10px; font: 500 12px 'Nunito', sans-serif; cursor: pointer; }
