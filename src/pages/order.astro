	.tb-ic, .tb-op, .tb-cp { justify-content: center; }
	.tb-span { grid-column: 5 / -1; }
	.tb-seat select { width: 100%; padding: 7px 10px; font-size: 12.5px; font-family: 'Nunito', sans-serif; color: #5A5A5A; border-radius: 999px; background-color: #F7EEDF; border: 1px solid #EBD9BC; }
