		function evBlock(e, i) {
			var p = evParts(e);
			var yr = new Date().getFullYear();
			var yrs = [];
			for (var y = yr; y < yr + 4; y++) yrs.push([String(y), String(y)]);
			if (p.year && yrs.every(function (o) { return o[0] !== p.year; })) yrs.unshift([p.year, p.year]);
			var days = [];
			for (var k = 1; k <= 31; k++) days.push([String(k), String(k)]);
			var hrs = [];
			for (var hh = 1; hh <= 12; hh++) hrs.push([String(hh), String(hh)]);
			var mins = [];
			for (var mm = 0; mm < 60; mm += 5) mins.push([('0' + mm).slice(-2), ('0' + mm).slice(-2)]);
			if (p.minute && mins.every(function (o) { return o[0] !== p.minute; })) mins.push([p.minute, p.minute]);
