	.od-top h1 { font: 700 clamp(1.6rem, 3.4vw, 2.2rem) 'Playfair Display', serif; color: #1A1A1A; margin: 2px 0 4px; }
	.od-top .od-exp { font-size: 13px; color: #5A5A5A; margin: 0; }
	.pg-h { margin: 0 0 16px; padding-bottom: 12px; border-bottom: 1px solid #EBDDC3; }
