			h += '<div class="f"><label>Time</label><div class="three">' + evSel(i, 'hour', 'Hour', hrs, p.hour) + evSel(i, 'minute', 'Min', mins, p.minute) + evSel(i, 'ampm', 'AM/PM', [['AM', 'AM'], ['PM', 'PM']], p.ampm) + '</div></div>';
