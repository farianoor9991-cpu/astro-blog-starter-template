		function mountFinder() {
			var m = document.getElementById('od-finder');
			if (!m || !window.IHCombos) return;
			var after = function () { setDirty(true); renderLinksOnly(); saveSoon(500); };
			window.IHCombos.createLinks({
				mount: m,
				showHeading: false,
				getEvents: function () { return O.events.map(function (e) { return { id: e.id, label: evLabel(e) }; }); },
				getLinks: function () { return O.links.filter(function (l) { return !l.main && l.cards.length; }).map(function (l) { return { id: l.id, cards: l.cards.slice() }; }); },
				add: function (cards) {
					if (!editing) { askPin(); return null; }
					var nl = { id: uid(), label: '', cards: O.events.map(function (e) { return e.id; }).filter(function (id) { return cards.indexOf(id) >= 0; }) };
					nl.label = comboLabel(nl);
					O.links.push(nl);
					after();
					return nl.id;
				},
				update: function (id, cards) {
					if (!editing) { askPin(); return; }
					var l = O.links.filter(function (x) { return x.id === id; })[0];
					if (!l) return;
					l.cards = O.events.map(function (e) { return e.id; }).filter(function (i) { return cards.indexOf(i) >= 0; });
					l.label = comboLabel(l);
					after();
				},
				remove: function (id) {
					if (!editing) { askPin(); return false; }
					var ix = -1;
					O.links.forEach(function (l, i) { if (l.id === id) ix = i; });
					if (ix < 0) return true;
					var l0 = O.links[ix];
					var cnt = O.guests.filter(function (g) { return g.linkId === l0.id; }).length;
					if (!confirm('Remove ' + comboTitle(l0) + '?' + (cnt ? ' Its ' + cnt + ' guest(s) will move to Link 1.' : ''))) return false;
					O.guests.forEach(function (g) { if (g.linkId === l0.id) g.linkId = O.links[0].id; });
					O.links.splice(ix, 1);
					after();
					return true;
				}
			});
		}
