		function pvPaint(kind) {
			var sfx = kind === 'b' ? '2' : kind === 'c' ? '3' : '';
			var box = document.getElementById('od-pv' + sfx);
			var st = pv[kind];
			if (!box || !st.cards) return;
			if (!st.cards.length) { box.innerHTML = '<p class="hint">No cards to show yet.</p>'; return; }
			var keep = 0;
			var old = document.getElementById('od-pvt' + sfx);
			if (old && old.clientWidth) keep = Math.round(old.scrollLeft / old.clientWidth);
			if (st.reset) { keep = 0; st.reset = false; }
			var h = '<div class="pv-wrap"><button type="button" class="pv-ar pv-l" data-pv="-1" data-pvt="' + sfx + '" aria-label="Previous card">&#8249;</button><div class="pv-track" id="od-pvt' + sfx + '">';
			st.cards.forEach(function (c) {
				h += '<figure class="pv-slide"><img src="' + c.url + '" alt="' + esc(c.label) + '" draggable="false"><figcaption>' + esc(c.label) + '</figcaption></figure>';
			});
			h += '</div><button type="button" class="pv-ar pv-r" data-pv="1" data-pvt="' + sfx + '" aria-label="Next card">&#8250;</button></div><div class="pv-dots" id="od-pvd' + sfx + '">';
			st.cards.forEach(function (c, i) { h += '<i' + (i === keep ? ' class="on"' : '') + '></i>'; });
			h += '</div>';
			box.innerHTML = h;
			var tr = document.getElementById('od-pvt' + sfx);
			if (keep && tr.clientWidth) tr.scrollLeft = keep * tr.clientWidth;
