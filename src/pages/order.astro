---
import PageLayout from '../layouts/PageLayout.astro';
import { haya } from '../data/templates/haya';
import { hayaEnvelope } from '../data/haya-envelope';

// Used only to draw the card preview (no envelope on this page)
const previewConfig = { design: hayaEnvelope, template: haya, invitation: { couple: {}, events: [], hosts: [], guest: '' }, cardsOnly: true };
---

<PageLayout title="Your Order" description="Manage your invitation links." showReviews={false}>
	<div class="od" id="od">
		<p class="od-state" id="od-state">Loading your order...</p>
	</div>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Berkshire+Swash&family=Unna:wght@400;700&display=swap" />
	<div id="env-root" hidden></div>
	<script is:inline id="env-config" type="application/json" set:html={JSON.stringify(previewConfig)} />
	<div class="od-bar" id="od-bar" hidden>
		<span id="od-status">All changes saved</span>
		<button type="button" id="od-save">Save now</button>
	</div>
</PageLayout>

<script is:inline>
	(function () {
		var T = new URLSearchParams(location.search).get('t') || '';
		var root = document.getElementById('od');
		var stateEl = document.getElementById('od-state');
		var bar = document.getElementById('od-bar');
		var statusEl = document.getElementById('od-status');
		var saveBtn = document.getElementById('od-save');
		var O = null;
		var dirty = false;
		var openAc = { preview: true };
		var shown = 10;
		var query = '';
		var addGroup = null; // a group being created: { label, cards: [] }
		var LABELS = { nikkah: 'Nikkah', dholki: 'Dholki', qawaali: 'Qawali Night', mehndi: 'Mehndi', baraat: 'Baraat', walima: 'Walima' };
		var DEFAULT_TEMPLATE =
			'Assalam-o-Alaikum {name},\n\n{couple} warmly invite you to their celebration. We have prepared a personal invitation for you. Please tap the link below to open it:\n\n{link}\n\nWe would be honoured to have you with us.';
		var CHEV = '<svg class="chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';

		function esc(s) {
			return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
				return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
			});
		}
		function first(n) {
			return String(n || '').trim().split(/\s+/)[0] || '';
		}
		function tc(s) {
			return String(s || '').toLowerCase().replace(/(^|[\s.\-'])([a-z])/g, function (m, a, b) {
				return a + b.toUpperCase();
			});
		}
		function coupleTitle() {
			return tc(first(O.couple.brideName)) + ' & ' + tc(first(O.couple.groomName));
		}
		function evLabel(e) {
			return e.label || LABELS[e.id] || e.id;
		}
		function many() {
			return O.links.length > 1;
		}
		function slug(s) {
			return String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 30);
		}
		function coupleSlug() {
			return (slug(first(O.couple.brideName)) || 'bride') + '-' + (slug(first(O.couple.groomName)) || 'groom');
		}
		function guestLink(g) {
			return location.origin + '/i?couple=' + coupleSlug() + '&guest=' + (slug(g.name) || 'guest') + '&p=' + O.pid + '&g=' + g.id;
		}
		function groupLink(l) {
			return location.origin + '/i?couple=' + coupleSlug() + '&p=' + O.pid + (many() ? '&l=' + l.id : '');
		}
		function expiry() {
			var d = new Date(O.createdAt);
			d.setUTCMonth(d.getUTCMonth() + 3);
			return d;
		}
		function hostsOn() {
			return O.hostsOn !== undefined ? !!O.hostsOn : O.hosts.length > 0;
		}
		function message(name, link) {
			var t = O.template || DEFAULT_TEMPLATE;
			return t
				.replace(/\{name\}/g, name)
				.replace(/\{couple\}/g, coupleTitle())
				.replace(/\{link\}/g, link)
				.replace(/ +,/g, ',');
		}
		function waUrl(text) {
			return 'https://wa.me/?text=' + encodeURIComponent(text);
		}
		var timer = null;
		var saving = false;
		var again = false;
		function setDirty(v) {
			dirty = v;
			statusEl.textContent = v ? 'Saving in a moment...' : 'All changes saved';
			bar.classList.toggle('dirty', v);
			clearTimeout(timer);
			if (v) timer = setTimeout(function () { save(); }, 1200);
			if (v) pvRefresh();
		}
		function uid() {
			return 'g' + Math.random().toString(36).slice(2, 8);
		}

		/* ---------- main area ---------- */
		function linkRow(title, sub, link, name, attr) {
			var msg = message(name, link);
			return (
				'<div class="od-row"' + attr + '>' +
				'<div class="c-name">' + title + (sub ? '<small>' + esc(sub) + '</small>' : '') + '</div>' +
				'<div class="c-msg"><div class="msg">' + esc(msg) + '</div></div>' +
				'<div class="c-act">' +
				'<button type="button" class="btn-s" data-copy="' + esc(link) + '">Copy link</button>' +
				'<button type="button" class="btn-s" data-copy="' + esc(msg) + '" data-msg="1">Copy message</button>' +
				'<a class="btn-s wa" target="_blank" rel="noopener" href="' + esc(waUrl(msg)) + '">WhatsApp</a>' +
				'<a class="btn-s" target="_blank" rel="noopener" href="' + esc(link) + '">Open</a>' +
				'</div></div>'
			);
		}
		function groupsHtml() {
			var h = '<section class="od-sec"><h2>' + (many() ? 'Group links' : 'Main invitation link') + '</h2>';
			h += '<p class="hint">' + (many() ? 'Send each link to the group it is meant for.' : 'This link has all your cards. Send it to everyone.') + '</p><div class="od-list">';
			O.links.forEach(function (l, i) {
				var cards = O.events.filter(function (e) { return l.cards.indexOf(e.id) >= 0; }).map(evLabel);
				if (O.hosts.length) cards.push('Reception Hosts');
				h += linkRow('<b>' + esc(many() ? l.label : 'Everyone') + '</b>', cards.join(', '), groupLink(l), '', ' data-li="' + i + '"');
			});
			return h + '</div></section>';
		}
		function guestsListHtml() {
			var q = query.trim().toLowerCase();
			var idx = [];
			O.guests.forEach(function (g, i) {
				if (!q || g.name.toLowerCase().indexOf(q) >= 0) idx.push(i);
			});
			var h = '';
			idx.slice(0, shown).forEach(function (i) {
				var g = O.guests[i];
				var sel = '';
				if (many()) {
					sel = '<select data-glink="' + i + '" aria-label="Group">' + O.links.map(function (l) {
						return '<option value="' + esc(l.id) + '"' + (l.id === g.linkId ? ' selected' : '') + '>' + esc(l.label) + '</option>';
					}).join('') + '</select>';
				}
				var title = '<input class="lbl" data-gname="' + i + '" value="' + esc(g.name) + '" aria-label="Guest name" maxlength="45">' + sel;
				if (g.id) {
					var row = linkRow(title, '', guestLink(g), g.name, ' data-gi="' + i + '"');
					h += row.replace(/<\/div><\/div>$/, '<button type="button" class="rm" data-grm="' + i + '">Remove</button></div></div>');
				} else {
					h += '<div class="od-row"><div class="c-name">' + title + '</div><div class="c-msg"><small>Save to create this link</small></div><div class="c-act"><button type="button" class="rm" data-grm="' + i + '">Remove</button></div></div>';
				}
			});
			if (!idx.length) h = '<p class="hint">' + (q ? 'No guest matches your search.' : 'No guests yet.') + '</p>';
			if (idx.length > shown) h += '<button type="button" class="btn-s more" id="od-more">Show ' + Math.min(10, idx.length - shown) + ' more (' + (idx.length - shown) + ' left)</button>';
			return h;
		}
		function guestsHtml() {
			if (!O.guestsOn) return '';
			var h = '<section class="od-sec"><h2>Personalized links <span class="cnt">' + O.guests.length + ' guest' + (O.guests.length === 1 ? '' : 's') + '</span></h2>';
			h += '<p class="hint">Each guest has their own link, and it opens with a greeting card carrying their name.</p>';
			h += '<div class="od-tools"><input type="search" id="od-q" placeholder="Search guests" value="' + esc(query) + '" aria-label="Search guests">';
			h += '<button type="button" class="btn-p" data-ac-open="addguests">+ Add guests</button></div>';
			h += '<div class="od-add" id="od-addbox" hidden>';
			if (many()) h += '<label for="od-newgroup">Which group are these guests in?</label><select id="od-newgroup"><option value="">Choose a group...</option>' + O.links.map(function (l) { return '<option value="' + esc(l.id) + '">' + esc(l.label) + '</option>'; }).join('') + '</select><div style="height:10px"></div>';
			h += '<label for="od-new">One name per line</label><textarea id="od-new" rows="4" placeholder="Hamza Chachu\nMr. Ali &amp; Family"></textarea>';
			h += '<button type="button" class="btn-p" id="od-addg">Add guests</button></div>';
			h += '<div class="od-list" id="od-glist">' + guestsListHtml() + '</div></section>';
			return h;
		}

		/* ---------- side panels ---------- */
		function acPanel(key, title, body) {
			var open = openAc[key];
			return '<section class="ac' + (open ? ' open' : '') + '"><button type="button" class="ac-h" data-ac="' + key + '" aria-expanded="' + !!open + '"><span>' + title + '</span>' + CHEV + '</button><div class="ac-b">' + body + '</div></section>';
		}
		function eventsBody() {
			var h = '<p class="hint">You can change the date, time and venue of each event.</p>';
			O.events.forEach(function (e, i) {
				h += '<div class="od-ev"><div class="od-ev-h"><b>' + esc(evLabel(e)) + '</b></div>';
				h += '<div class="two"><div class="f"><label>Date</label><input type="date" data-e="' + i + '" data-k="date" value="' + esc(e.date) + '"></div>';
				h += '<div class="f"><label>Time</label><input type="time" data-e="' + i + '" data-k="time" value="' + esc(e.time) + '"></div></div>';
				h += '<div class="f"><label>Venue</label><input data-e="' + i + '" data-k="venue" value="' + esc(e.venue) + '" maxlength="140"></div></div>';
			});
			return h;
		}
		function hostsBody() {
			var h = '';
			O.hosts.forEach(function (x, i) {
				h += '<div class="od-ev"><div class="f"><label>Name</label><input data-h="' + i + '" data-k="name" value="' + esc(x.name) + '" maxlength="60"></div>';
				h += '<div class="f"><label>Phone</label><input data-h="' + i + '" data-k="phone" value="' + esc(x.phone) + '" maxlength="25"></div>';
				h += '<button type="button" class="rm" data-hrm="' + i + '">Remove host</button></div>';
			});
			if (!O.hosts.length) h += '<p class="hint">No reception hosts added.</p>';
			if (O.hosts.length < 6) h += '<button type="button" class="btn-s" id="od-addh">+ Add host</button>';
			return h;
		}
		function messageBody() {
			return '<p class="hint">Write the message once. A ready message is made for every link. Use <b>{name}</b>, <b>{couple}</b> and <b>{link}</b> where they should appear.</p>' +
				'<textarea id="od-tpl" rows="9">' + esc(O.template || DEFAULT_TEMPLATE) + '</textarea><button type="button" class="lnk" id="od-reset">Use the default message</button>';
		}
		function cardsChecks(cards, attr) {
			return '<div class="checks">' + O.events.map(function (e) {
				return '<label class="chk"><input type="checkbox" ' + attr + '="' + esc(e.id) + '"' + (cards.indexOf(e.id) >= 0 ? ' checked' : '') + '> ' + esc(evLabel(e)) + '</label>';
			}).join('') + '</div>';
		}
		function linksBody() {
			var h = '<p class="hint">' + (many() ? 'Each group gets its own link with the cards you tick.' : 'Right now everyone gets one link with all cards. Create a group to send some guests only some cards.') + '</p>';
			if (many()) {
				O.links.forEach(function (l, i) {
					h += '<div class="od-ev"><div class="od-ev-h"><input class="lbl" data-link="' + i + '" value="' + esc(l.label) + '" maxlength="40" aria-label="Group name"><button type="button" class="rm" data-lrm="' + i + '">Remove</button></div>';
					h += cardsChecks(l.cards, 'data-lcard="' + i + '" data-id') + '</div>';
				});
			}
			if (addGroup) {
				h += '<div class="od-ev"><b>New group</b><div class="f"><label>Group name</label><input id="od-gname" value="' + esc(addGroup.label) + '" maxlength="40" placeholder="e.g. Friends"></div>';
				h += '<label class="lab">Cards for this group</label>' + cardsChecks(addGroup.cards, 'data-ncard') + '<div class="od-inline"><button type="button" class="btn-p" id="od-gcreate">Create group</button><button type="button" class="lnk" id="od-gcancel">Cancel</button></div></div>';
			} else {
				h += '<button type="button" class="btn-s" id="od-gnew">+ Create a group link</button>';
			}
			return h;
		}


		/* ---------- card preview ---------- */
		var pv = { sig: '', cards: null, timer: null, guestId: '', busy: false };
		function pvInvitation() {
			var g = null;
			if (O.guestsOn && O.guests.length) {
				g = O.guests.filter(function (x) { return x.id === pv.guestId; })[0] || O.guests[0];
			}
			var evs = O.events;
			if (g && many()) {
				var lk = O.links.filter(function (l) { return l.id === g.linkId; })[0];
				if (lk) evs = O.events.filter(function (e) { return lk.cards.indexOf(e.id) >= 0; });
			}
			return {
				couple: O.couple,
				events: evs,
				hosts: hostsOn() ? O.hosts.filter(function (h) { return String(h.name || '').trim(); }) : [],
				guest: g && g.name.trim() ? g.name : '',
				gid: g ? g.id : '',
			};
		}
		function previewBody() {
			var h = '<p class="hint">This is how the cards look. Swipe left or right to see every card.</p>';
			if (O.guestsOn && O.guests.length > 1) {
				h += '<label class="lab" for="od-pvguest">Show cards for</label><select id="od-pvguest">' + O.guests.map(function (g) {
					return '<option value="' + esc(g.id) + '"' + (g.id === pv.guestId ? ' selected' : '') + '>' + esc(g.name) + '</option>';
				}).join('') + '</select><div style="height:10px"></div>';
			}
			h += '<div class="pv" id="od-pv"><p class="hint">Loading preview...</p></div>';
			return h;
		}
		function pvPaint() {
			var box = document.getElementById('od-pv');
			if (!box || !pv.cards) return;
			if (!pv.cards.length) { box.innerHTML = '<p class="hint">No cards to show yet.</p>'; return; }
			var h = '<div class="pv-wrap"><button type="button" class="pv-ar pv-l" data-pv="-1" aria-label="Previous card">&#8249;</button><div class="pv-track" id="od-pvt">';
			pv.cards.forEach(function (c) {
				h += '<figure class="pv-slide"><img src="' + c.url + '" alt="' + esc(c.label) + '" draggable="false"><figcaption>' + esc(c.label) + '</figcaption></figure>';
			});
			h += '</div><button type="button" class="pv-ar pv-r" data-pv="1" aria-label="Next card">&#8250;</button></div><div class="pv-dots" id="od-pvd">';
			pv.cards.forEach(function (c, i) { h += '<i' + (i === 0 ? ' class="on"' : '') + '></i>'; });
			h += '</div>';
			box.innerHTML = h;
			var tr = document.getElementById('od-pvt');
			tr.addEventListener('scroll', function () {
				var i = Math.round(tr.scrollLeft / tr.clientWidth);
				var ds = document.querySelectorAll('#od-pvd i');
				for (var k = 0; k < ds.length; k++) ds[k].className = k === i ? 'on' : '';
			});
		}
		function pvEngine() {
			return new Promise(function (res, rej) {
				if (window.__ihCards) return res();
				window.__ihCardsReady = res;
				var sc = document.createElement('script');
				sc.src = '/envelope-engine.js?v=15';
				sc.onerror = rej;
				document.head.appendChild(sc);
			});
		}
		function pvRefresh() {
			clearTimeout(pv.timer);
			pv.timer = setTimeout(function () {
				if (!document.getElementById('od-pv')) return;
				var inv = pvInvitation();
				var sig = JSON.stringify(inv);
				if (sig === pv.sig && pv.cards) { pvPaint(); return; }
				pv.sig = sig;
				pvEngine().then(function () { return window.__ihCards(JSON.parse(sig)); }).then(function (list) {
					if (pv.sig !== sig) return;
					pv.cards = list;
					pvPaint();
				}).catch(function () {
					var box = document.getElementById('od-pv');
					if (box) box.innerHTML = '<p class="hint">The preview could not be loaded. Please refresh the page.</p>';
				});
			}, 600);
		}

		function render() {
			var y = window.scrollY;
			var h = '<div class="od-head"><span class="od-no">Order No. ' + esc(O.orderNo) + '</span><h1>' + esc(coupleTitle()) + '</h1>';
			h += '<p>Everything for your invitation is here: your links, your WhatsApp messages and your card details.</p>';
			var ex = expiry();
			h += '<p class="od-exp">Your invitation links are live until <b>' + ex.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) + '</b>' + (Date.now() > ex.getTime() ? ' (expired)' : ' (3 months from your order)') + '. After this date they stop showing the invitation.</p>';
			h += '<p class="od-warn">Please save this page\'s link. It is private, and anyone who has it can edit your invitation. <button type="button" class="lnk" data-copy="' + esc(location.href) + '">Copy this page link</button></p></div>';
			h += '<div class="od-cols"><div class="od-main">' + groupsHtml() + guestsHtml() + '</div>';
			h += '<aside class="od-side"><h3>Edit your invitation</h3>';
			h += acPanel('message', 'Edit WhatsApp message', messageBody());
			h += acPanel('events', 'Edit events', eventsBody());
			if (hostsOn()) h += acPanel('hosts', 'Edit reception hosts', hostsBody());
			h += acPanel('preview', 'Preview your cards', previewBody());
			h += '</aside></div>';
			root.innerHTML = h;
			pvRefresh();
			document.title = coupleTitle() + ' | Order ' + O.orderNo;
			window.scrollTo(0, y);
		}
		function renderGuestList() {
			var el = document.getElementById('od-glist');
			if (el) el.innerHTML = guestsListHtml();
		}

		function setState(text) {
			stateEl.textContent = text;
			stateEl.style.display = text ? 'block' : 'none';
		}
		function problem() {
			for (var k = 0; k < O.guests.length; k++) if (!O.guests[k].name.trim()) return 'Please fill in every guest name (or remove the guest).';
			for (var i = 0; i < O.links.length; i++) {
				if (many() && !O.links[i].cards.length) return 'The group "' + O.links[i].label + '" needs at least one event.';
			}
			return '';
		}
		function save(full) {
			clearTimeout(timer);
			var p = problem();
			if (p) {
				statusEl.textContent = p;
				return;
			}
			if (saving) {
				again = true;
				return;
			}
			saving = true;
			statusEl.textContent = 'Saving...';
			var sent = JSON.stringify(O);
			fetch('/api/order?t=' + encodeURIComponent(T), {
				method: 'PUT',
				headers: { 'content-type': 'application/json' },
				body: sent,
			})
				.then(function (r) {
					if (!r.ok) return r.json().then(function (j) { throw new Error(j.error || 'x'); });
					return r.json();
				})
				.then(function (d) {
					saving = false;
					var needs = full || O.guests.some(function (g) { return !g.id; });
					if (needs && !again) {
						O = d;
						render();
					} else if (d.guests && d.guests.length === O.guests.length) {
						d.guests.forEach(function (g, i) { if (!O.guests[i].id) O.guests[i].id = g.id; });
					}
					if (again) {
						again = false;
						save();
						return;
					}
					dirty = false;
					bar.classList.remove('dirty');
					statusEl.textContent = 'All changes saved';
				})
				.catch(function (e) {
					saving = false;
					again = false;
					statusEl.textContent = e.message && e.message !== 'x' && e.message !== 'Failed to fetch' ? e.message : 'Could not save. Please check your internet and try again.';
				});
		}

		/* ---------- events ---------- */
		function rowMessage(row) {
			var gi = row.dataset.gi;
			var li = row.dataset.li;
			var name = '';
			var link = '';
			if (gi !== undefined) {
				var g = O.guests[Number(gi)];
				if (!g || !g.id) return;
				name = g.name;
				link = guestLink(g);
				var cl = row.querySelector('[data-copy]:not([data-msg])');
				if (cl) cl.dataset.copy = link;
				var op = row.querySelector('a:not(.wa)');
				if (op) op.href = link;
			} else if (li !== undefined) {
				link = groupLink(O.links[Number(li)]);
			} else return;
			var msg = message(name, link);
			var m = row.querySelector('.msg');
			if (m) m.textContent = msg;
			var cm = row.querySelector('[data-msg]');
			if (cm) cm.dataset.copy = msg;
			var wa = row.querySelector('.wa');
			if (wa) wa.href = waUrl(msg);
		}
		function refreshMessages() {
			root.querySelectorAll('.od-row').forEach(rowMessage);
		}
		function removeEventEverywhere(id) {
			O.links.forEach(function (l) { l.cards = l.cards.filter(function (c) { return c !== id; }); });
		}

		root.addEventListener('input', function (ev) {
			var t = ev.target;
			var d = t.dataset;
			if (t.id === 'od-tpl') {
				O.template = t.value;
				refreshMessages();
			} else if (t.id === 'od-q') {
				query = t.value;
				shown = 10;
				renderGuestList();
				return;
			} else if (d.e !== undefined) O.events[Number(d.e)][d.k] = t.value;
			else if (d.h !== undefined) O.hosts[Number(d.h)][d.k] = t.value;
			else if (d.gname !== undefined) {
				O.guests[Number(d.gname)].name = t.value;
				var row = t.closest('.od-row');
				if (row) rowMessage(row);
			} else if (d.link !== undefined) O.links[Number(d.link)].label = t.value;
			else if (t.id === 'od-gname') {
				addGroup.label = t.value;
				return;
			} else return;
			setDirty(true);
		});
		root.addEventListener('change', function (ev) {
			var t = ev.target;
			var d = t.dataset;
			if (t.id === 'od-pvguest') {
				pv.guestId = t.value;
				pvRefresh();
			} else if (d.glink !== undefined) {
				O.guests[Number(d.glink)].linkId = t.value;
				setDirty(true);
			} else if (d.lcard !== undefined) {
				var l = O.links[Number(d.lcard)];
				l.cards = l.cards.filter(function (c) { return c !== d.id; });
				if (t.checked) l.cards.push(d.id);
				setDirty(true);
			} else if (d.ncard !== undefined) {
				addGroup.cards = addGroup.cards.filter(function (c) { return c !== d.ncard; });
				if (t.checked) addGroup.cards.push(d.ncard);
			}
		});
		root.addEventListener('click', function (ev) {
			var b = ev.target.closest('button');
			if (!b) return;
			var d = b.dataset;
			if (d.pv !== undefined) {
				var tr = document.getElementById('od-pvt');
				if (tr) tr.scrollBy({ left: Number(d.pv) * tr.clientWidth, behavior: 'smooth' });
				return;
			}
			if (d.copy !== undefined) {
				var txt = d.copy;
				var old = b.textContent;
				var ok = function () {
					b.textContent = 'Copied';
					setTimeout(function () { b.textContent = old; }, 1400);
				};
				if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(ok);
				else {
					var ta = document.createElement('textarea');
					ta.value = txt;
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					ta.remove();
					ok();
				}
			} else if (d.ac) {
				openAc[d.ac] = !openAc[d.ac];
				var sec = b.closest('.ac');
				sec.classList.toggle('open', !!openAc[d.ac]);
				b.setAttribute('aria-expanded', String(!!openAc[d.ac]));
			} else if (d.acOpen === 'addguests') {
				var box = document.getElementById('od-addbox');
				box.hidden = !box.hidden;
				if (!box.hidden) document.getElementById('od-new').focus();
			} else if (b.id === 'od-more') {
				shown += 10;
				renderGuestList();
			} else if (b.id === 'od-reset') {
				O.template = DEFAULT_TEMPLATE;
				setDirty(true);
				var tp = document.getElementById('od-tpl');
				tp.value = DEFAULT_TEMPLATE;
				refreshMessages();
			} else if (d.grm !== undefined) {
				var gi = Number(d.grm);
				if (confirm('Remove ' + O.guests[gi].name + '? Their personal link will stop working after you save.')) {
					O.guests.splice(gi, 1);
					setDirty(true);
					render();
				}
			} else if (d.hrm !== undefined) {
				O.hosts.splice(Number(d.hrm), 1);
				setDirty(true);
				render();
			} else if (b.id === 'od-addh') {
				O.hosts.push({ name: '', phone: '' });
				setDirty(true);
				render();
			} else if (b.id === 'od-gnew') {
				addGroup = { label: '', cards: [] };
				render();
			} else if (b.id === 'od-gcancel') {
				addGroup = null;
				render();
			} else if (b.id === 'od-gcreate') {
				var label = (addGroup.label || '').trim();
				if (!label) {
					alert('Please give the group a name.');
					return;
				}
				if (!addGroup.cards.length) {
					alert('Please tick at least one event for this group.');
					return;
				}
				if (O.links.length === 1) O.links[0].label = 'Everyone';
				O.links.push({ id: uid(), label: label, cards: addGroup.cards.slice() });
				addGroup = null;
				setDirty(true);
				render();
			} else if (d.lrm !== undefined) {
				var li = Number(d.lrm);
				if (confirm('Remove the group "' + O.links[li].label + '"? Its guests will move to the first group.')) {
					var gone = O.links[li].id;
					O.links.splice(li, 1);
					O.guests.forEach(function (g) { if (g.linkId === gone) g.linkId = O.links[0].id; });
					setDirty(true);
					render();
				}
			} else if (b.id === 'od-addg') {
				var nb = document.getElementById('od-new');
				var names = nb.value.split(/[\n,]/).map(function (x) { return x.trim(); }).filter(Boolean);
				if (!names.length) return;
				var gsel = document.getElementById('od-newgroup');
				if (gsel && !gsel.value) {
					alert('Please choose which group these guests belong to.');
					gsel.focus();
					return;
				}
				var longName = names.filter(function (n) { return n.length > 45; })[0];
				if (longName) {
					alert('"' + longName.slice(0, 20) + '..." is too long. Please keep each name within 45 characters.');
					return;
				}
				if (O.guests.length + names.length > 500) {
					alert('You can add up to 500 guests.');
					return;
				}
				names.forEach(function (n) {
					O.guests.push({ id: '', name: tc(n), linkId: gsel && gsel.value ? gsel.value : O.links[0].id });
				});
				save(true);
			}
		});
		saveBtn.addEventListener('click', function () { save(true); });
		window.addEventListener('beforeunload', function (e) {
			if (dirty) {
				e.preventDefault();
				e.returnValue = '';
			}
		});

		if (!/^[a-z0-9]{24}$/.test(T)) {
			setState('This order link is not valid. Please open the link you were given after your order.');
			return;
		}
		fetch('/api/order?t=' + encodeURIComponent(T), { cache: 'no-store' })
			.then(function (r) { if (!r.ok) throw new Error('x'); return r.json(); })
			.then(function (d) {
				O = d;
				setState('');
				bar.hidden = false;
				render();
				setDirty(false);
			})
			.catch(function () {
				setState('We could not find this order. Please check the link you were given.');
			});
	})();
</script>

