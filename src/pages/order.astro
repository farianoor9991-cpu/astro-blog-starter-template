	.tb-name .gn .lbl:not([readonly]) + .gtxt { display: none; }
	.tb-name .gn .pen { position: static; transform: none; flex: 0 0 auto; width: 26px; height: 26px; opacity: 0.75; }
	.rm-i { flex: 0 0 auto; width: 24px; height: 24px; border: 0; border-radius: 50%; background: transparent; color: #b08a84; font-size: 18px; line-height: 1; cursor: pointer; padding: 0; }
