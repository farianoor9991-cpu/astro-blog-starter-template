		.tb-msg::before, .tb-url::before, .tb-grp::before, .tb-ph::before, .tb-seat::before { content: attr(data-l); font: 600 10.5px 'Nunito', sans-serif; letter-spacing: 0.08em; text-transform: uppercase; color: #9A6A36; margin-bottom: 4px; }
		.tb-ic, .tb-op { justify-content: stretch; }
