	.nv-i i { flex: 0 0 auto; width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid #D4A276; display: grid; place-items: center; font: 600 12px 'Poppins', sans-serif; font-style: normal; color: #9A6A36; background: #fff; }
	.nv-i.on i { background: #1A1A1A; border-color: #1A1A1A; color: #fff; }
	.nv-i i.nv-d { border: 0; background: transparent; color: inherit; }
	.nv-i i.nv-d svg { width: 18px; height: 18px; }
	.nv-foot { display: none; margin: 18px 8px 0; padding-top: 12px; border-top: 1px solid #F0E6D2; font-size: 12px; color: #7a6a58; }
	.od .od-content, main.od-content { min-width: 0; width: auto; max-width: none; margin: 0; container-type: inline-size; container-name: dash; }
	.od-top { margin: 0 0 14px; }
