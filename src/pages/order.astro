				getChosen: function () { return O.links.filter(function (l) { return !l.main; }).map(function (l) { return l.cards.slice(); }); },
				isSelected: function (k) { return O.links.some(function (l) { return !l.main && key(l.cards) === key(k.split('+')); }); },
