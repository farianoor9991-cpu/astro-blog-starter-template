		// "Hamza Chachu 0333111111", "Mr Ali Khan 2 03331111111", "Ali Khan 2"  ->  name, seats (0 = full family), phone
		function parseGuestLine(ln) {
			var t = ln.trim().split(/\s+/);
			var dg = function (x) { return x.replace(/\D/g, '').length; };
			var tail = [];
			while (t.length > 1 && /^[+\d\-]+$/.test(t[t.length - 1]) && dg(t[t.length - 1]) >= 3) tail.unshift(t.pop());
			var phone = '';
			if (tail.length && tail.join('').replace(/\D/g, '').length >= 7) phone = tail.join('');
			else t = t.concat(tail);
			var seats = 0;
			if (t.length > 1) {
				var z = t[t.length - 1];
				if (/^f$/i.test(z)) t.pop();
				else if (/^\d{1,2}$/.test(z)) { seats = Number(z); t.pop(); }
			}
			return { name: t.join(' ').replace(/[,|:\-\s]+$/, '').trim() || ln.trim(), phone: phone.replace(/[^0-9+]/g, ''), seats: seats };
		}
		// while typing, the card shows only the name: anything from the seats letter / number or the phone number onwards is left out
