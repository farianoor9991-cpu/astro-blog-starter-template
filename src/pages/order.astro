	.tb-t { font-size: 13px; color: #5A5A5A; }
	.tb-msg .msg p { margin: 0 0 5px; }
	.tb-msg .msg p:last-child { margin: 0; }
	.tb-msg .msg { max-height: none; overflow: visible; border: 0; background: transparent; padding: 0; font-size: 12px; line-height: 1.5; color: #5A5A5A; white-space: pre-line; overflow-wrap: anywhere; }
	.urlb { display: flex; align-items: center; gap: 7px; width: 100%; min-width: 0; text-align: left; background: #FCF9F1; border: 1px dashed #D9B98F; color: #6b4a22; border-radius: 8px; padding: 8px 10px; font: 500 12px 'Poppins', sans-serif; cursor: pointer; }
	.urlb:hover { background: #F7EEDF; border-style: solid; }
	.urlb .url { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.tb-ic, .tb-op, .tb-cp { justify-content: center; }
	.tb-span { grid-column: 5 / -1; }
	.tb-seat select { width: 100%; padding: 7px 10px; font-size: 12.5px; font-family: 'Poppins', sans-serif; color: #5A5A5A; border-radius: 999px; background-color: #F7EEDF; border: 1px solid #EBD9BC; }
	.od .ic { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #25D366; color: #fff; text-decoration: none; }
	.od .ic:hover { background: #1fb558; }
	.od .qa { display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid #E4D2B2; color: #5A5A5A; background: #fff; border-radius: 999px; padding: 7px 12px; font: 500 12.5px 'Poppins', sans-serif; text-decoration: none; cursor: pointer; white-space: nowrap; }
	.od .qa:hover { background: #F7EEDF; }
	.gd-note { font-size: 12px; color: #7a6a58; }
	.od .sec-h .btn-p { white-space: nowrap; }
	.od-addev .rm { display: inline-block; }
	/* narrower area: every row becomes a small card, nothing is hidden */
	@container dash (max-width: 900px) {
		.tb:not(.tb-m):not(.tb-g) > .tb-head, .tb:not(.tb-m):not(.tb-g) > .tb-row { min-width: 0; }
		.tb-head { display: none; }
		.tb-row { grid-template-columns: 1fr 1fr; padding: 6px 4px; }
		.tb-c { border-right: 0; padding: 6px 10px; }
		.tb-name { grid-column: 1 / -1; }
		.tb-grp { grid-column: 1 / -1; }
		.tb-seat { grid-column: 1 / -1; }
		.tb-g .tb-name { grid-column: 1 / -1; }
		.tb-msg, .tb-url, .tb-cp { grid-column: 1 / -1; }
		.tb-msg, .tb-url, .tb-grp, .tb-ph, .tb-seat { flex-direction: column; align-items: stretch; }
		.tb-ph { grid-column: 1 / -1; }
		.tb-msg::before, .tb-url::before, .tb-grp::before, .tb-ph::before, .tb-seat::before { content: attr(data-l); font: 600 10.5px 'Poppins', sans-serif; letter-spacing: 0.08em; text-transform: uppercase; color: #9A6A36; margin-bottom: 4px; }
		.tb-ic, .tb-op { justify-content: stretch; }
		.od .ic { width: 100%; border-radius: 999px; height: 38px; }
		.od .ic::after { content: 'WhatsApp'; font: 600 12.5px 'Poppins', sans-serif; margin-left: 6px; }
		.od .ic { display: inline-flex; align-items: center; justify-content: center; }
		.od .tb-op .qa, .od .tb-cp .qa { width: 100%; height: 38px; }
		.tb-span { grid-column: 1 / -1; }
		.urlb .url { white-space: normal; overflow-wrap: anywhere; }
	}
	@container dash (max-width: 520px) {
		.stats { gap: 8px; }
		.st { flex-direction: column; align-items: flex-start; gap: 8px; padding: 12px; }
		.st b { font-size: 1.5rem; }
		.od-sec { padding: 16px 10px; }
	}
	.od { max-width: 1560px; }
	@media (min-width: 1000px) {
		.od-cols { grid-template-columns: minmax(0, 1fr) 330px; }
		/* the Edit panel sits on the right, next to the wide tables, and scrolls on its own */
		.od-side { grid-column: 2; grid-row: 1; position: sticky; top: 12px; max-height: calc(100vh - 100px); overflow-y: auto; overscroll-behavior: contain; padding-right: 4px; scrollbar-width: thin; scrollbar-color: #D4A276 transparent; }
		.od-main { grid-column: 1; grid-row: 1; }
	}
	/* ---------- left menu + one page per step ---------- */
	.od { max-width: 1640px; padding-left: 20px; padding-right: 20px; }
	.od-shell { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; align-items: start; }
	.od-nav { background: #fff; border: 1px solid #EBDDC3; border-radius: 16px; padding: 18px 12px 14px; }
	.nv-brand { font: 700 22px 'Playfair Display', serif; color: #1A1A1A; padding: 0 8px; }
	.nv-brand b { color: #D4A276; font-weight: 700; }
	.nv-cap { font: 600 10.5px 'Poppins', sans-serif; letter-spacing: 0.14em; text-transform: uppercase; color: #9A6A36; margin: 16px 8px 8px; }
