					O.guests.push({ id: '', name: tc(n), linkId: gsel && gsel.value ? gsel.value : O.links[0].id });
				});
				setDirty(true);
				render();
			}
		});
		// clicking a guest (anywhere that is not a button, link or field) opens or closes their details
		root.addEventListener('click', function (ev) {
			var t = ev.target;
			var m = t.closest && t.closest('.gd-main');
			if (!m || t.closest('button, a, select') || (t.closest('input') && !t.closest('input').readOnly)) return;
			var tg = m.querySelector('.gd-tg');
			if (tg) tg.click();
		});
		saveBtn.addEventListener('click', function () { save(); });
		root.addEventListener('click', function (ev) {
			var b = ev.target.closest && ev.target.closest('#od-edit');
			if (b) askPin();
		});
		// Leaving the site pages with unsaved changes: ask first
		document.addEventListener('click', function (ev) {
			if (!dirty || !editing) return;
			var a = ev.target.closest && ev.target.closest('a[href]');
			if (!a || a.target === '_blank' || a.origin !== location.origin || a.closest('#od')) return;
			ev.preventDefault();
			var href = a.href;
			var m = popup('<h3>You have unsaved changes</h3><p class="hint">Save before leaving?</p><div class="od-inline"><button type="button" class="btn-p" id="od-ls">Save</button><button type="button" class="lnk" id="od-ll">Leave</button></div>');
			m.querySelector('#od-ls').onclick = function () { m.close(); save(function () { location.href = href; }); };
			m.querySelector('#od-ll').onclick = function () { writeDraft(); dirty = false; location.href = href; };
		}, true);
		window.addEventListener('beforeunload', function (e) {
			if (dirty && editing) {
				writeDraft();
				e.preventDefault();
				e.returnValue = '';
			}
		});

		if (!/^[a-z0-9]{24}$/.test(T)) {
			setState('This order link is not valid. Please open the link you were given after your order.');
			return;
		}
		fetch('/api/order?t=' + encodeURIComponent(T), { cache: 'no-store' })
			.then(function (r) { if (!r.ok) throw new Error('x'); return r.json(); })
			.then(function (d) {
				O = d;
				setState('');
				bar.hidden = false;
				render();
				setDirty(false);
				updateBar();
				// same browser as the one the order was made in: go straight to edit mode, no PIN prompt
				var sp = storedPin();
				if (sp && O.hasPin) {
					api({ action: 'verify', pin: sp }).then(function (d2) {
						PIN = sp;
						O = Object.assign({}, d2);
						if (O.locked) return api({ action: 'unlock', pin: sp }).then(function (d3) { O = Object.assign({}, d3); });
					}).then(function () {
						editing = true;
						render();
						updateBar();
						offerDraft();
					}).catch(function (e) { if (e && e.message === 'Wrong PIN') rememberPin(''); });
				}
			})
			.catch(function () {
				setState('We could not find this order. Please check the link you were given.');
			});
	})();
</script>

