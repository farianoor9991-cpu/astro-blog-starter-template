---
import PageLayout from '../layouts/PageLayout.astro';
import { haya } from '../data/templates/haya';
import { hayaEnvelope } from '../data/haya-envelope';

// Used only to draw the card preview (no envelope on this page)
const previewConfig = { design: hayaEnvelope, template: haya, invitation: { couple: {}, events: [], hosts: [], guest: '' }, cardsOnly: true };
---

<PageLayout title="Your Order" description="Manage your invitation links." showReviews={false}>
	<div class="od" id="od">
		<p class="od-state" id="od-state">Loading your order...</p>
	</div>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Berkshire+Swash&family=Unna:wght@400;700&display=swap" />
	<div id="env-root" hidden></div>
	<script is:inline id="env-config" type="application/json" set:html={JSON.stringify(previewConfig)} />
	<div class="od-bar" id="od-bar" hidden>
		<span id="od-status"></span>
		<span class="od-bar-r"><button type="button" id="od-save">Edit with PIN</button></span>
	</div>
</PageLayout>

<script is:inline>
	(function () {
		var T = new URLSearchParams(location.search).get('t') || '';
		var root = document.getElementById('od');
		var stateEl = document.getElementById('od-state');
		var bar = document.getElementById('od-bar');
		var statusEl = document.getElementById('od-status');
		var saveBtn = document.getElementById('od-save');
		var PIN = '';
		var editing = false;
		var O = null;
		var dirty = false;
		var openAc = { preview: true, preview2: true };
		var shown = 10;
		var query = '';
		var openG = {}; // which guest groups are expanded
		var openR = {}; // which rows show their details
		var addGroup = null; // a group being created: { label, cards: [] }
		var LABELS = { nikkah: 'Nikkah', dholki: 'Dholki', qawaali: 'Qawali Night', mehndi: 'Mehndi', baraat: 'Baraat', walima: 'Walima' };
		var DEFAULT_TEMPLATE =
			'Assalam-o-Alaikum {name},\n\n{couple} warmly invite you to their celebration. We have prepared a personal invitation for you. Please tap the link below to open it:\n\n{link}\n\nWe would be honoured to have you with us.';
		var PENCIL = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/></svg>';
		var TICK = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
		var CHEV = '<svg class="chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';

		function esc(s) {
			return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
				return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
			});
		}
		function first(n) {
			return String(n || '').trim().split(/\s+/)[0] || '';
		}
		function tc(s) {
			return String(s || '').toLowerCase().replace(/(^|[\s.\-'])([a-z])/g, function (m, a, b) {
				return a + b.toUpperCase();
			});
		}
		function coupleTitle() {
			return tc(first(O.couple.brideName)) + ' & ' + tc(first(O.couple.groomName));
		}
		function evLabel(e) {
			return e.label || LABELS[e.id] || e.id;
		}
		function many() {
			return O.links.length > 1;
		}
		function slug(s) {
			return String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 30);
		}
		function coupleSlug() {
			return (slug(first(O.couple.brideName)) || 'bride') + '-' + (slug(first(O.couple.groomName)) || 'groom');
		}
		// New style: /inviteheaven/maria-weds-ahtesham/guest=shaheer-aslam-&-family  (older orders keep their old links)
		function guestLink(g) {
			if (O.cslug && g.slug) return location.origin + '/inviteheaven/' + O.cslug + '/guest=' + g.slug;
			return location.origin + '/i?couple=' + coupleSlug() + '&guest=' + (slug(g.name) || 'guest') + '&p=' + O.pid + '&g=' + g.id;
		}
		function groupLink(l) {
			if (O.cslug) return location.origin + '/inviteheaven/' + O.cslug + (many() && l.slug ? '/group=' + l.slug : '');
			return location.origin + '/i?couple=' + coupleSlug() + '&p=' + O.pid + (many() ? '&l=' + l.id : '');
		}
		function expiry() {
			var d = new Date(O.createdAt);
			d.setUTCMonth(d.getUTCMonth() + 3);
			return d;
		}
		function hostsOn() {
			return O.hostsOn !== undefined ? !!O.hostsOn : O.hosts.length > 0;
		}
		function message(name, link) {
			var t = O.template || DEFAULT_TEMPLATE;
			return t
				.replace(/\{name\}/g, name)
				.replace(/\{couple\}/g, coupleTitle())
				.replace(/\{link\}/g, link)
				.replace(/ +,/g, ',');
		}
		function waUrl(text) {
			return 'https://wa.me/?text=' + encodeURIComponent(text);
		}
		var saving = false;
		var rev = 0; // goes up with every change, so a save knows if the customer typed while it was running
		var autoT = null;
		var draftT = null;
		function draftKey() { return 'ih-draft-' + T; }
		function editable(o) {
			return JSON.stringify({ events: o.events, hosts: o.hosts, links: o.links, guests: o.guests, template: o.template });
		}
		function writeDraft() {
			try { localStorage.setItem(draftKey(), editable(O)); } catch (e) {}
		}
		function clearDraft() {
			try { localStorage.removeItem(draftKey()); } catch (e) {}
		}
		function updateBar() {
			bar.classList.toggle('dirty', dirty && editing);
			saveBtn.textContent = editing ? 'Save changes' : 'Edit with PIN';
			if (!editing) statusEl.textContent = '';
			else if (dirty) statusEl.textContent = 'You have unsaved changes';
		}
		function setDirty(v) {
			dirty = v;
			if (!v) {
				statusEl.textContent = editing ? 'All changes saved' : '';
				clearTimeout(autoT);
			}
			updateBar();
			if (v) {
				rev++;
				pvRefresh();
				// 1) a copy in this browser right away (a moment after the last key press): nothing typed is ever lost
				clearTimeout(draftT);
				draftT = setTimeout(function () { if (editing && dirty && O) writeDraft(); }, 400);
				// 2) saved to the server by itself once the customer pauses for a while
				clearTimeout(autoT);
				autoT = setTimeout(autoSave, 45000);
				if (editing) statusEl.textContent = 'Saving automatically soon (a copy is kept in this browser)';
			}
		}
		function autoSave() {
			if (!editing || !dirty || saving || !O) return;
			if (problem()) { autoT = setTimeout(autoSave, 45000); return; }
			save(null, true);
		}
		// Leaving or switching away: keep a copy here, and send the changes if possible
		function flushOnLeave() {
			if (!editing || !dirty || !O) return;
			writeDraft();
			if (problem() || saving) return;
			try {
				var body = JSON.stringify(Object.assign({}, O, { pin: PIN }));
				if (body.length < 60000) fetch('/api/order?t=' + encodeURIComponent(T), { method: 'PUT', keepalive: true, headers: { 'content-type': 'application/json' }, body: body });
			} catch (e) {}
		}
		window.addEventListener('pagehide', flushOnLeave);
		document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') flushOnLeave(); });
		/* ---------- small pop-up windows ---------- */
		function popup(html) {
			var m = document.createElement('div');
			m.className = 'od-modal';
			m.innerHTML = '<div class="od-modal-in" role="dialog">' + html + '</div>';
			document.body.appendChild(m);
			m.close = function () { m.remove(); };
			return m;
		}
		function api(body) {
			return fetch('/api/order?t=' + encodeURIComponent(T), { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }).then(function (r) {
				return r.json().then(function (j) {
					if (!r.ok) throw new Error(j.error || 'x');
					return j;
				});
			});
		}
		// the PIN is remembered on the browser it was created / entered in, so the owner is not asked again there;
		// any other browser or device asks for it once
		function pinKey() { return 'ih-pin-' + T; }
		function rememberPin(p) { try { if (p) localStorage.setItem(pinKey(), p); else localStorage.removeItem(pinKey()); } catch (e) {} }
		function storedPin() { try { return localStorage.getItem(pinKey()) || ''; } catch (e) { return ''; } }
		function askPin() {
			var legacy = !O.hasPin;
			var m = popup('<h3>' + (legacy ? 'Create your Edit PIN' : 'Enter your Edit PIN') + '</h3><p class="hint">' + (legacy ? 'Choose a 4-digit PIN. You will need it every time you want to edit this order. Do not share it.' : 'Your link can only view this order. Enter your 4-digit PIN to edit.') + '</p><input id="od-pin" type="password" inputmode="numeric" autocomplete="off" maxlength="4" placeholder="4-digit PIN">' + (legacy ? '<div style="height:8px"></div><input id="od-pin2" type="password" inputmode="numeric" autocomplete="off" maxlength="4" placeholder="Repeat PIN">' : '') + '<p class="od-err" id="od-pinerr" hidden></p><div class="od-inline"><button type="button" class="btn-p" id="od-pinok">' + (legacy ? 'Set PIN and edit' : 'Unlock editing') + '</button><button type="button" class="lnk" id="od-pinno">Cancel</button></div>');
			var inp = m.querySelector('#od-pin');
			var err = m.querySelector('#od-pinerr');
			inp.focus();
			[inp, m.querySelector('#od-pin2')].forEach(function (x) {
				if (x) x.addEventListener('input', function () { x.value = x.value.replace(/\D/g, '').slice(0, 4); });
			});
			function fail(t) { err.textContent = t; err.hidden = false; }
			function go() {
				var pin = inp.value;
				if (!/^\d{4}$/.test(pin)) return fail('Please enter 4 digits.');
				var body = { action: 'verify', pin: pin };
				if (legacy) {
					if (pin !== m.querySelector('#od-pin2').value) return fail('The two PINs do not match.');
					body = { action: 'verify', newPin: pin };
				}
				api(body).then(function (d) {
					PIN = pin;
					rememberPin(pin);
					m.close();
					O = Object.assign({}, d);
					var afterUnlock = function () {
						editing = true;
						render();
						updateBar();
						offerDraft();
					};
					if (d.locked) {
						api({ action: 'unlock', pin: pin }).then(function (d2) { O = Object.assign({}, d2); afterUnlock(); }).catch(function () { render(); updateBar(); });
					} else afterUnlock();
				}).catch(function (e) {
					fail(e.message === 'Wrong PIN' ? 'Wrong PIN' : e.message && e.message !== 'x' ? e.message : 'Something went wrong. Please try again.');
				});
			}
			m.querySelector('#od-pinok').onclick = go;
			m.querySelector('#od-pinno').onclick = function () { m.close(); };
			inp.addEventListener('keydown', function (e) { if (e.key === 'Enter') go(); });
		}
		function offerDraft() {
			var raw = null;
			try { raw = localStorage.getItem(draftKey()); } catch (e) {}
			if (!raw || raw === editable(O)) { if (raw) clearDraft(); return; }
			var m = popup('<h3>You have unsaved edits from last time</h3><p class="hint">Do you want to restore them?</p><div class="od-inline"><button type="button" class="btn-p" id="od-dr">Restore Draft</button><button type="button" class="lnk" id="od-dd">Discard</button></div>');
			m.querySelector('#od-dr').onclick = function () {
				try {
					var d = JSON.parse(raw);
					['events', 'hosts', 'links', 'guests', 'template'].forEach(function (k) { if (d[k] !== undefined) O[k] = d[k]; });
					m.close();
					setDirty(true);
					render();
				} catch (e) { m.close(); }
			};
			m.querySelector('#od-dd').onclick = function () { clearDraft(); m.close(); };
		}
		function uid() {
			return 'g' + Math.random().toString(36).slice(2, 8);
		}

		/* ---------- main area ---------- */
		function icon(n) {
			var p = {
				chev: '<path d="M6 9l6 6 6-6"/>',
				link: '<path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"/>',
				msg: '<path d="M21 12a8 8 0 01-11.6 7.1L4 20l1-4.6A8 8 0 1121 12z"/>',
				open: '<path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"/>',
				users: '<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><path d="M16 5.2a3 3 0 010 5.6"/><path d="M18 14.8c1.8.6 3 2.2 3 4.7"/>',
				cards: '<rect x="4" y="6" width="12" height="14" rx="2"/><path d="M8 3h10a2 2 0 012 2v12"/>'
			}[n];
			return '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + p + '</svg>';
		}
		function actions(link, msg) {
			return (
				'<button type="button" class="qa" data-copy="' + esc(link) + '">' + icon('link') + '<span><i class="lg">Copy link</i><i class="sh">Link</i></span></button>' +
				'<button type="button" class="qa" data-copy="' + esc(msg) + '" data-msg="1">' + icon('msg') + '<span><i class="lg">Copy message</i><i class="sh">Message</i></span></button>' +
				'<a class="qa wa" target="_blank" rel="noopener" href="' + esc(waUrl(msg)) + '"><span>WhatsApp</span></a>' +
				'<a class="qa op" target="_blank" rel="noopener" href="' + esc(link) + '">' + icon('open') + '<span><i class="lg">Open</i><i class="sh">Open</i></span></a>'
			);
		}
		function details(msg, link, extra) {
			return (
				'<div class="gd-det"><div class="gd-dl">Invitation message</div><div class="msg">' + esc(msg) + '</div>' +
				'<div class="gd-dl">Invitation URL</div><div class="gd-url"><span class="url">' + esc(link) + '</span><button type="button" class="qa" data-copy="' + esc(link) + '">' + icon('link') + '<span>Copy</span></button></div>' +
				(extra || '') + '</div>'
			);
		}
		// one row: used for the group / main links and for every guest
		function dashRow(name, sub, link, gname, attr, extra, open, tgAttr) {
			var msg = message(gname, link);
			return (
				'<div class="od-row gd' + (open ? ' open' : '') + '"' + attr + '>' +
				'<div class="gd-main"><button type="button" class="gd-tg" ' + tgAttr + ' aria-label="Show details" aria-expanded="' + (open ? 'true' : 'false') + '">' + icon('chev') + '</button>' +
				'<div class="gd-name">' + name + (sub ? '<small>' + esc(sub) + '</small>' : '') + '</div>' +
				'<div class="gd-act">' + actions(link, msg) + '</div></div>' +
				details(msg, link, extra) + '</div>'
			);
		}
		function stats() {
			var saved = O.guests.filter(function (g) { return g.id; }).length;
			var box = function (ic, n, l) { return '<div class="st"><span class="st-i">' + icon(ic) + '</span><div><b>' + n + '</b><small>' + l + '</small></div></div>'; };
			if (O.guestsOn) return '<div class="stats">' + box('users', O.guests.length, 'Total guests') + box('cards', O.links.length, O.links.length === 1 ? 'Group' : 'Groups') + box('link', saved, 'Personalized links') + '</div>';
			return '<div class="stats">' + box('cards', O.events.length + (hostsOn() ? 1 : 0), 'Cards') + box('users', O.links.length, O.links.length === 1 ? 'Group' : 'Groups') + box('link', O.links.length, O.links.length === 1 ? 'Invitation link' : 'Invitation links') + '</div>';
		}
		function groupsHtml() {
			var h = '<section class="od-sec"><h2>' + (many() ? 'Group links' : 'Main invitation link') + '</h2>';
			h += '<p class="hint">' + (many() ? 'Send each link to the group it is meant for.' : 'This link has all your cards. Send it to everyone.') + '</p><div class="od-list">';
			O.links.forEach(function (l, i) {
				var cards = O.events.filter(function (e) { return l.cards.indexOf(e.id) >= 0; }).map(evLabel);
				if (O.hosts.length) cards.push('Reception Hosts');
				h += dashRow('<b>' + esc(many() ? l.label : 'Everyone') + '</b>', cards.join(', '), groupLink(l), '', ' data-li="' + i + '"', '', !!openR['l' + i], 'data-rtog="l' + i + '"');
			});
			return h + '</div></section>';
		}
		function guestRow(i) {
			var g = O.guests[i];
			var sel = '';
			if (many()) {
				sel = '<select data-glink="' + i + '" aria-label="Group">' + O.links.map(function (l) {
					return '<option value="' + esc(l.id) + '"' + (l.id === g.linkId ? ' selected' : '') + '>' + esc(l.label) + '</option>';
				}).join('') + '</select>';
			}
			var title = '<span class="gn"><input class="lbl" data-gname="' + i + '" value="' + esc(g.name) + '" aria-label="Guest name" maxlength="45" readonly><button type="button" class="pen" data-gedit="' + i + '" aria-label="Edit name" title="Edit name">' + PENCIL + '</button></span>';
			var rm = '<button type="button" class="rm" data-grm="' + i + '">Remove this guest</button>';
			var open = !!openR['g' + i];
			if (g.id) {
				var link = guestLink(g);
				var msg = message(g.name, link);
				return (
					'<div class="od-row gd' + (open ? ' open' : '') + '" data-gi="' + i + '">' +
					'<div class="gd-main"><button type="button" class="gd-tg" data-rtog="g' + i + '" aria-label="Show details" aria-expanded="' + (open ? 'true' : 'false') + '">' + icon('chev') + '</button>' +
					'<div class="gd-name">' + title + '</div><div class="gd-grp">' + sel + '</div>' +
					'<div class="gd-act">' + actions(link, msg) + '</div></div>' + details(msg, link, rm) + '</div>'
				);
			}
			return '<div class="od-row gd" data-gi="' + i + '"><div class="gd-main gd-new"><span></span><div class="gd-name">' + title + '</div><div class="gd-grp">' + sel + '</div><div class="gd-act"><small class="gd-note">Save to create this link</small>' + rm + '</div></div></div>';
		}
		function guestsListHtml() {
			var q = query.trim().toLowerCase();
			var groups = many() ? O.links : [{ id: '*', label: 'All guests', cards: [] }];
			var buckets = groups.map(function () { return []; });
			O.guests.forEach(function (g, i) {
				if (q && g.name.toLowerCase().indexOf(q) < 0) return;
				var k = many() ? groups.findIndex(function (l) { return l.id === g.linkId; }) : 0;
				buckets[k < 0 ? 0 : k].push(i);
			});
			var any = buckets.some(function (b) { return b.length; });
			if (!any) return '<p class="hint">' + (q ? 'No guest matches your search.' : 'No guests yet.') + '</p>';
			var h = '<div class="gd-head"><span>Guest name</span>' + (many() ? '<span>Group</span>' : '<span></span>') + '<span>Quick actions</span></div>';
			groups.forEach(function (l, k) {
				var rows = buckets[k];
				if (q && !rows.length) return;
				var total = O.guests.filter(function (g) { return many() ? g.linkId === l.id : true; }).length;
				var isOpen = q ? true : openG[l.id] !== undefined ? openG[l.id] : k === 0;
				h += '<div class="gd-group' + (isOpen ? ' open' : '') + '"><button type="button" class="gd-gh" data-gtg="' + esc(l.id) + '" aria-expanded="' + (isOpen ? 'true' : 'false') + '"><span class="gd-gc">' + icon('chev') + '</span><b>' + esc(l.label || 'Group') + '</b><span class="cnt">' + (q ? rows.length + ' of ' + total : total) + ' guest' + (total === 1 ? '' : 's') + '</span></button>';
				h += '<div class="gd-rows">' + (rows.length ? rows.map(guestRow).join('') : '<p class="hint" style="padding:10px 14px;margin:0">No guests in this group yet.</p>') + '</div></div>';
			});
			return h;
		}
		function guestsHtml() {
			if (!O.guestsOn) return '';
			var h = '<section class="od-sec"><h2>Guest list</h2>';
			h += '<p class="hint">Each guest has their own personalized link. It opens with a greeting card carrying their name.</p>';
			h += '<div class="od-tools"><input type="search" id="od-q" placeholder="Search guests by name..." value="' + esc(query) + '" aria-label="Search guests">';
			h += '<button type="button" class="btn-p" data-ac-open="addguests">+ Add guests</button></div>';
			h += '<div class="od-add" id="od-addbox" hidden>';
			if (many()) h += '<label for="od-newgroup">Which group are these guests in?</label><select id="od-newgroup"><option value="">Choose a group...</option>' + O.links.map(function (l) { return '<option value="' + esc(l.id) + '">' + esc(l.label) + '</option>'; }).join('') + '</select><div style="height:10px"></div>';
			h += '<label for="od-new">One name per line</label><textarea id="od-new" rows="4" placeholder="Hamza Chachu\nMr. Ali &amp; Family"></textarea>';
			h += '<button type="button" class="btn-p" id="od-addg">Add guests</button></div>';
			h += '<div class="od-list" id="od-glist">' + guestsListHtml() + '</div></section>';
			return h;
		}

		
		/* ---------- side panels ---------- */
		function acPanel(key, title, body) {
			var open = openAc[key];
			return '<section class="ac' + (open ? ' open' : '') + '"><button type="button" class="ac-h" data-ac="' + key + '" aria-expanded="' + !!open + '"><span>' + title + '</span>' + CHEV + '</button><div class="ac-b">' + body + '</div></section>';
		}
		function eventsBody() {
			var h = '<p class="hint">You can change the date, time and venue of each event.</p>';
			O.events.forEach(function (e, i) {
				h += '<div class="od-ev"><div class="od-ev-h"><b>' + esc(evLabel(e)) + '</b></div>';
				h += '<div class="two"><div class="f"><label>Date</label><input type="date" data-e="' + i + '" data-k="date" value="' + esc(e.date) + '"></div>';
				h += '<div class="f"><label>Time</label><input type="time" data-e="' + i + '" data-k="time" value="' + esc(e.time) + '"></div></div>';
