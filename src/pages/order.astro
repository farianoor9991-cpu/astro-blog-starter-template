	.st b { display: block; font-family: 'Playfair Display', serif; font-size: 1.9rem; line-height: 1.05; color: #1A1A1A; font-weight: 700; }
	.st small { display: block; font-size: 12.5px; color: #7a6a58; line-height: 1.3; margin-top: 2px; }
	.od-sec { background: #fff; border: 1px solid #EFE3CC; border-radius: 18px; padding: 24px; box-shadow: 0 1px 3px rgba(120, 90, 50, 0.05); }
	.od-sec h2 { font-family: 'Playfair Display', serif; font-size: 1.45rem; font-weight: 700; color: #1A1A1A; margin: 0 0 4px; }
	.od-sec > .hint { color: #7a6a58; margin: 0 0 16px; }
	.od-list { display: grid; gap: 10px; }
	/* ---------- Excel-like tables (guests and group links) ---------- */
	.sec-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; margin-bottom: 4px; }
	.sec-h .hint { margin-bottom: 14px; }
	.od-tools { display: flex; gap: 10px; flex-wrap: wrap; margin: 0 0 16px; }
	.od-tools input[type="search"] { flex: 1 1 220px; min-width: 0; border-radius: 999px; padding: 11px 18px; }
	.od-tools select { flex: 0 0 auto; width: auto; border-radius: 999px; padding: 10px 16px; }
	.tb { border: 1px solid #EBDDC3; border-radius: 12px; overflow: hidden; background: #fff; }
	.tb-head, .tb-row { display: grid; column-gap: 0; align-items: stretch; }
	.tb { --cols: minmax(110px, 1.1fr) 134px 118px 140px minmax(130px, 2fr) minmax(90px, 0.8fr) 92px 88px; overflow-x: auto; }
	.tb:not(.tb-m):not(.tb-g) > .tb-head, .tb:not(.tb-m):not(.tb-g) > .tb-row { min-width: 900px; }
	.tb-g { --cols: minmax(160px, 1fr) minmax(240px, 2.4fr) minmax(150px, 1.3fr) 112px 92px 92px; }
	.tb-head, .tb-row { grid-template-columns: var(--cols); }
	.tb-head { background: #F7EEDF; font: 600 11px 'Poppins', sans-serif; letter-spacing: 0.09em; text-transform: uppercase; color: #9A6A36; border-bottom: 1px solid #EBDDC3; }
