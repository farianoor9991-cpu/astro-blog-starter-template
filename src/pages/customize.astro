---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Customize" description="Personalize your invitation cards." showReviews={false}>
	<script is:inline src="/ih-combos.js?v=5"></script>
	<div class="cz" id="cz">
		<div id="cz-main">
			<header class="cz-head">
				<h1 class="cz-title">Customize: <span id="cz-name"></span></h1>
				<p class="cz-sub">Fill in your details step by step. Your cards update as you type.</p>
				<div class="cz-progress">
					<div class="cz-bar-t"><i id="cz-fill"></i></div>
					<span class="cz-lab" id="cz-lab"></span>
				</div>
			</header>

			<div class="cz-grid">
				<div class="gwin" id="cz-draftbox" hidden style="margin-bottom:12px"><b>You have a saved draft</b><small>Saved in this browser from last time. Do you want to continue with it?</small><div class="acts" style="margin-top:8px"><button class="btn-g" type="button" data-act="restore">Restore draft</button> <button class="btn-o" type="button" data-act="discard">Discard</button></div></div>
				<div id="cz-steps"></div>
				<aside class="cz-aside">
					<div class="cz-aside-in">
						<canvas data-preview></canvas>
						<div class="pcombo" data-pcombo></div><div class="ptabs" data-tabs></div>
						<p class="wm-note">Preview only. Your final cards will not have the watermark.</p>
						<div class="cz-asidebar">
							<button class="btn-o" type="button" data-act="envelope">See it in the envelope</button>
							<span class="pr" data-price></span>
						</div>
					</div>
				</aside>
			</div>

			<div class="cz-bar">
				<button class="btn-o" type="button" data-act="envelope" style="flex:1;padding:12px 14px">See it in the envelope</button>
				<span class="pr" data-price></span>
			</div>

			<div class="cz-modal" id="cz-modal">
				<div class="cz-sheet" role="dialog" aria-label="Card preview">
					<div class="cz-sheet-h"><b>Preview</b><button class="lnk" type="button" data-act="close">Close</button></div>
					<canvas data-preview></canvas>
					<div class="pcombo" data-pcombo></div><div class="ptabs" data-tabs></div>
					<p class="wm-note">Preview only. Your final cards will not have the watermark.</p>
				</div>
			</div>
		</div>

		<div id="cz-missing" hidden>
			<h1 class="cz-title">Customize</h1>
			<p class="cz-sub">This design can't be customized yet. Please pick a design from our catalogue.</p>
			<p class="cz-center"><a class="btn-g" href="/catalogue">Browse the catalogue</a></p>
		</div>
	</div>
</PageLayout>

<script>
	import { templates } from '../data/templates/index';
	import { categories } from '../data/designs';

	type D = Record<string, any>;

	const mainEl = document.getElementById('cz-main') as HTMLElement;
	const missingEl = document.getElementById('cz-missing') as HTMLElement;
	const designId = new URLSearchParams(location.search).get('design') || '';
	const found: D | undefined = (templates as D)[designId];

	if (!found) {
		mainEl.hidden = true;
		missingEl.hidden = false;
	} else {
		start(found);
	}

	function start(tpl: D) {
		const price: string = categories.website.price;
const KEY = 'ih-customize-v2:' + tpl.id;
const MAX_HOSTS: number = tpl.maxHosts || 6;
		const L: D = tpl.eventLayout;
		const HL: D = tpl.hostsLayout;
		const GL: D = tpl.guestLayout;
		const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
		const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
		const STEPS = [
			{ n: 1, d: 1, title: 'Couple details', sub: 'Names of the bride, groom and their parents' },
			{ n: 2, d: 2, title: 'Your events', sub: 'Choose your events' },
			{ n: 7, d: 3, title: 'Create Separate Links for Different Guests', sub: 'Choose event/events for each Invitation Link' },
			{ n: 3, d: 4, title: 'Reception hosts card', sub: 'Do you want a Reception Hosts card?' },
			{ n: 4, d: 5, title: 'Share links', sub: 'Get links for each event. Greeting cards are optional.' },
			{ n: 6, d: 6, title: 'Who fills card details?', sub: 'Do it yourself for free, or let our team do it' },
			{ n: 5, d: 7, title: 'Review and preview', sub: 'See your cards before paying' },
		];

		const $ = (s: string) => document.querySelector(s) as HTMLElement | null;
		const esc = (s: unknown) =>
			String(s ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as D)[ch]);
		const uid = () => 'l' + Date.now().toString(36) + Math.floor(Math.random() * 1000).toString(36);
		const tc = (s: string) =>
			String(s || '')
				.trim()
				.replace(/\s+/g, ' ')
				.replace(/(^|[\s\-'])(\p{L})/gu, (_m: string, a: string, b: string) => a + b.toUpperCase());
		const cleanParents = (s: string) =>
			String(s || '')
				.trim()
				.replace(/^(d\s*\/\s*o|s\s*\/\s*o)\s*/i, '')
				.replace(/^mr\.?\s*(&|and)\s*mrs\.?\s*/i, '')
				.trim();
		const digits = (s: string) => String(s || '').replace(/\D/g, '');
		const parseDate = (v: string): Date | null => {
			const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v || '');
			if (!m) return null;
			const d = new Date(+m[1], +m[2] - 1, +m[3]);
			return isNaN(d.getTime()) ? null : d;
		};
		const fmtTime = (v: string) => {
			const m = /^(\d{1,2}):(\d{2})/.exec(v || '');
			if (!m) return '';
			let h = +m[1];
			const ap = h >= 12 ? 'PM' : 'AM';
			h = h % 12 || 12;
			return m[2] === '00' ? `At ${h} ${ap}` : `At ${h}:${m[2]} ${ap}`;
		};

		/* ---------- state ---------- */
		const blank = (): D => ({
			open: 1,
			done: {},
			active: tpl.events.find(e => e.label.toLowerCase().includes('nikah'))?.id || tpl.events[0].id,
			couple: { brideName: '', brideParents: '', groomName: '', groomParents: '' },
			events: {},
			hosts: { want: null, list: [], draft: { name: '', phone: '' } },
			links: { mode: 'one', list: [] },
			setup: 'self',
			guests: { on: false, one: '' },
		});
		let S: D = blank();

tpl.events.forEach((e: D) => {
    S.events[e.id] = { on: false, date: '', time: '', venue: '' };
});

const save = () => {};
		const evDef = (id: string): D => tpl.events.find((e: D) => e.id === id);
		const selEvents = (): D[] => tpl.events.filter((e: D) => S.events[e.id].on);
		const byDate = (a: D, b: D) => {
			const da = S.events[a.id].date || '9999';
			const db = S.events[b.id].date || '9999';
			return da < db ? -1 : da > db ? 1 : tpl.events.indexOf(a) - tpl.events.indexOf(b);
		};
		const pkg = (): string[] => {
			const ids = selEvents().sort(byDate).map((e: D) => e.id);
			if (S.hosts.want) ids.push('hosts');
			return ids;
		};
		const tabsAll = (): string[] => {
			let p = pkg();
			if (!selEvents().length) p = [tpl.events[0].id].concat(p); // nothing chosen yet: the preview shows the first event card, never the hosts card
			return S.guests.on ? ['guest'].concat(p) : p;
		};
		// the preview can be limited to one card combination (the cards that link would show)
		const pvLink = (): D | null => (S.pvCombo ? S.links.list.find((l: D) => l.id === S.pvCombo && l.cards.length) || null : null);
		const tabs = (): string[] => {
			const all = tabsAll();
			const lk = pvLink();
			if (!lk) return all;
			const some = all.filter((id) => id === 'guest' || id === 'hosts' || lk.cards.indexOf(id) >= 0);
			return some.filter((id) => id !== 'guest' && id !== 'hosts').length ? some : all;
		};
		const label = (id: string) => (id === 'hosts' ? 'Reception Hosts' : id === 'guest' ? 'Greeting card' : evDef(id).label);
		const ensureActive = () => {
    const t = tabs();
    if (!t.length) return;
    else if (t.indexOf(S.active) < 0) S.active = t[0];
};
		const hostCount = () => S.hosts.list.filter((h: D) => h.name.trim()).length;
		/* ---------- personalized greetings (add-on) ---------- */
		/* ---------- prices (change them here) ---------- */
		const P_BASE = 7000; // the package (envelope, event cards, hosts card, groups)
		const P_ADDON = 2999; // personalized greeting cards add-on
		const P_TEAM = 1999; // our team sets everything up
		const P_FULL = P_BASE + P_ADDON; // 9,999, shown at the top of the form
		const fmtRs = (n: number) => 'Rs. ' + n.toLocaleString('en-US');
		const priceLines = (): { t: string; v: number }[] => {
			const out: { t: string; v: number }[] = [];
			if (!pkg().length) return out;
			out.push({ t: 'Invitation package', v: P_BASE });
			if (S.guests.on) out.push({ t: 'Personalized greeting cards add-on', v: P_ADDON });
			if (S.setup === 'team') out.push({ t: 'Set-up by our team', v: P_TEAM });
			return out;
		};
		const totalPrice = () => priceLines().reduce((a, l) => a + l.v, 0);
		const updatePrice = () => {
			document.querySelectorAll('[data-price]').forEach((el) => (el.textContent = fmtRs(totalPrice() || P_BASE)));
		};
		const TEST = /[?&]test=1/.test(location.search);
		const GUEST_MAX = 50;
		const GUEST_NAME_MAX = 45;
		let gMore = false;
		const gNames = (text: string): string[] =>
			String(text || '')
				.split(/[\n,]/)
				.map((x) => x.trim())
				.filter(Boolean);
		const gDisplay = (raw: string): string => tc(raw);
		const allGuests = (): D[] => (S.guests.on ? [{ raw: 'Shaheer Aslam', name: 'Shaheer Aslam', link: null, linkNo: 0 }] : []);
		const guestEvents = (g: D): string[] => {
			const ids = g.link ? g.link.cards : selEvents().map((e: D) => e.id);
			return selEvents().sort(byDate).map((e: D) => e.id).filter((id: string) => ids.indexOf(id) >= 0);
		};
		const syncLinks = () => {
			const ok = pkg();
			S.links.list.forEach((lk: D) => {
				lk.cards = lk.cards.filter((k: string) => ok.indexOf(k) >= 0);
			});
			const seen = new Set<string>();
			S.links.list = S.links.list.filter((lk: D) => {
				const k = lk.cards.slice().sort().join('+');
				const all = selEvents().length;
				if (!lk.cards.length || lk.cards.length >= all || seen.has(k)) return false;
				seen.add(k);
				return true;
			});
		};

		/* ---------- fonts and images ---------- */
		const fontsReady: Promise<void> = (async () => {
			await new Promise<void>((res) => {
				const l = document.createElement('link');
				l.rel = 'stylesheet';
				l.href = 'https://fonts.googleapis.com/css2?family=Unna:wght@400;700&family=Berkshire+Swash&family=Nunito:wght@400;500;600;700;800&display=swap';
				l.onload = () => res();
				l.onerror = () => res();
				document.head.appendChild(l);
			});
			try {
				await Promise.all([
					document.fonts.load('700 40px "Unna"'),
					document.fonts.load('400 40px "Berkshire Swash"'),
					document.fonts.load('700 40px "Playfair Display"'),
				]);
			} catch (e) {}
		})();

		const imgCache: D = {};
		const loadOne = (src: string): Promise<HTMLImageElement> => {
			if (!imgCache[src]) {
				imgCache[src] = new Promise((res, rej) => {
					const i = new Image();
					i.onload = () => res(i);
					i.onerror = () => rej(new Error(src));
					i.src = src;
				});
			}
			return imgCache[src];
		};
		const loadBg = async (list: string[]): Promise<HTMLImageElement | null> => {
			for (const s of list) {
				try {
					return await loadOne(s);
				} catch (e) {}
			}
			return null;
		};

		/* ---------- what is written on each card ---------- */
		const texts = (id: string): D => {
			const def = evDef(id);
			const e = S.events[id];
			const c = S.couple;
			const sm = tpl.sample;
			const real = (t: string) => ({ t, real: true });
			const fake = (t: string) => ({ t, real: false });
			const d = parseDate(e.date);
			const dd = d || (parseDate(def.sample.date) as Date);
			const dr = !!d;
			const bp = cleanParents(c.brideParents);
			const gp = cleanParents(c.groomParents);
			const venue = String(e.venue || '').trim();
			return {
				title: real(def.title),
				brideName: c.brideName.trim() ? real(tc(c.brideName)) : fake(sm.brideName),
				brideParents: bp ? real('D/O Mr & Mrs ' + tc(bp)) : fake('D/O Mr & Mrs ' + sm.brideParents),
				groomName: c.groomName.trim() ? real(tc(c.groomName)) : fake(sm.groomName),
				groomParents: gp ? real('S/O Mr & Mrs ' + tc(gp)) : fake('S/O Mr & Mrs ' + sm.groomParents),
				month: { t: MONTHS[dd.getMonth()], real: dr },
				dayName: { t: DAYS[dd.getDay()], real: dr },
				date: { t: String(dd.getDate()).padStart(2, '0'), real: dr },
				year: { t: String(dd.getFullYear()), real: dr },
				time: e.time ? real(fmtTime(e.time)) : fake(fmtTime(def.sample.time)),
				venue: venue ? real('Venue: ' + venue) : fake('Venue: ' + tpl.sampleVenue),
			};
		};
		const hostRows = (): D[] => {
			const filled = S.hosts.list.filter((h: D) => h.name.trim());
			if (filled.length) {
				return filled.map((h: D) => ({ t: tc(h.name) + (h.phone.trim() ? '\u2003\u2002' + h.phone.trim() : ''), real: true }));
			}
			return tpl.sampleHosts.map((h: D) => ({ t: h.name + '\u2003\u2002' + h.phone, real: false }));
		};

		/* ---------- drawing ---------- */
		const tokens = new WeakMap<HTMLCanvasElement, number>();
		let tokenN = 0;

		const put = (ctx: CanvasRenderingContext2D, t: string, f: D, W: number, H: number, real: boolean) => {
			let size = f.size * W;
			ctx.font = `${f.weight} ${size}px "${f.font}", serif`;
			const w = ctx.measureText(t).width;
			const max = f.maxW * W;
			if (w > max) {
				size = Math.max((size * max) / w, size * 0.55);
				ctx.font = `${f.weight} ${size}px "${f.font}", serif`;
			}
			ctx.globalAlpha = real ? 1 : 0.4;
			ctx.fillStyle = tpl.color;
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			ctx.fillText(t, f.x * W, f.y * H);
			ctx.globalAlpha = 1;
		};

		const putGuest = (ctx: CanvasRenderingContext2D, t: string, f: D, W: number, H: number, real: boolean) => {
			const full = f.size * W;
			const max = f.maxW * W;
			const setF = (sz: number) => (ctx.font = `${f.weight} ${sz}px "${f.font}", serif`);
			ctx.globalAlpha = real ? 1 : 0.4;
			ctx.fillStyle = tpl.color;
			ctx.textAlign = 'center';
			setF(full);
			if (ctx.measureText(t).width <= max) {
				ctx.textBaseline = 'middle';
				ctx.fillText(t, f.x * W, f.y * H);
				ctx.globalAlpha = 1;
				return;
			}
			let lines = wrapWords(ctx, t, max);
			if (lines.length > 2) lines = [lines[0], lines.slice(1).join(' ')];
			const widest = () => Math.max(...lines.map((l) => ctx.measureText(l).width));
			let sc = 1;
			let sx = 1;
			let wd = widest();
			if (wd > max) {
				sc = Math.max(max / wd, 0.5);
				setF(full * sc);
				wd = widest();
				if (wd > max) sx = max / wd;
			}
			const gap = f.gap * W * sc;
			const mid = f.wrapY * H + (f.gap * W) / 2;
			const base = lines.length === 1 ? mid : mid - gap / 2;
			ctx.textBaseline = 'alphabetic';
			lines.forEach((l, i) => {
				ctx.save();
				ctx.translate(f.x * W, base + i * gap);
				ctx.scale(sx, 1);
				ctx.fillText(l, 0, 0);
				ctx.restore();
			});
			ctx.globalAlpha = 1;
		};

		const wrapWords = (ctx: CanvasRenderingContext2D, str: string, maxPx: number): string[] => {
			const words = str.split(/\s+/);
			const lines: string[] = [];
			let cur = '';
			for (const w of words) {
				const t = cur ? cur + ' ' + w : w;
				if (ctx.measureText(t).width > maxPx && cur) {
					lines.push(cur);
					cur = w;
				} else cur = t;
			}
			if (cur) lines.push(cur);
			return lines;
		};

		const drawVenue = (ctx: CanvasRenderingContext2D, v: D, f: D, W: number, H: number) => {
			let size = f.size * W;
			const setFont = (s: number) => (ctx.font = `${f.weight} ${s}px "${f.font}", serif`);
			setFont(size);
			const maxPx = f.maxW * W;
			const full = ctx.measureText(v.t).width;
			let lines: string[] = [v.t];
			if (v.t.indexOf(',') >= 0 && full > W * 0.4) {
				let best = -1;
				let bestW = Infinity;
				for (let i = 0; i < v.t.length; i++) {
					if (v.t[i] !== ',') continue;
					const a = v.t.slice(0, i + 1).trim();
					const b = v.t.slice(i + 1).trim();
					if (!b) continue;
					const m = Math.max(ctx.measureText(a).width, ctx.measureText(b).width);
					if (m < bestW) {
						bestW = m;
						best = i;
					}
				}
				if (best >= 0) lines = [v.t.slice(0, best + 1).trim(), v.t.slice(best + 1).trim()];
			}
			if (lines.length === 1 && full > maxPx) lines = wrapWords(ctx, v.t, maxPx);
			if (lines.length > 2) lines = [lines[0], lines.slice(1).join(' ')];
			const widest = Math.max(...lines.map((l) => ctx.measureText(l).width));
			if (widest > maxPx) {
				size = Math.max((size * maxPx) / widest, size * 0.6);
				setFont(size);
			}
			ctx.globalAlpha = v.real ? 1 : 0.4;
			ctx.fillStyle = tpl.color;
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			lines.forEach((l, i) => ctx.fillText(l, f.x * W, f.y * H + i * f.lh * H));
			ctx.globalAlpha = 1;
		};

		// true while the couple / events / hosts on the form are still exactly the sample ones (no watermark then);
		// as soon as the customer types or changes any of their own details, the watermark is back
		const isSample = (): boolean => {
			const sm = tpl.sample;
			const n = (v: any) => String(v || '').trim();
			const c = S.couple;
			if (n(c.brideName) !== n(sm.brideName) || n(c.brideParents) !== n(sm.brideParents) || n(c.groomName) !== n(sm.groomName) || n(c.groomParents) !== n(sm.groomParents)) return false;
			const on = tpl.events.filter((e: D) => S.events[e.id] && S.events[e.id].on);
			if (!on.length) return false;
			for (const e of on) {
				const v = S.events[e.id];
				if (n(v.date) !== n(e.sample.date) || n(v.time) !== n(e.sample.time) || n(v.venue) !== n(tpl.sampleVenue)) return false;
			}
			return true;
		};

		const watermark = (ctx: CanvasRenderingContext2D, W: number, H: number) => {
			ctx.save();
			ctx.translate(W / 2, H / 2);
			ctx.rotate(-Math.PI / 6);
						const size = W * 0.032;
			ctx.font = `700 ${size}px "Playfair Display", serif`;
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			ctx.lineWidth = size * 0.07;
			ctx.strokeStyle = 'rgba(39,96,65,0.34)';
			ctx.fillStyle = 'rgba(255,255,255,0.5)';
			const stepX = W * 0.31;
			const stepY = W * 0.13;
			let row = 0;
			for (let y = -H; y <= H; y += stepY) {
				const off = row % 2 ? stepX / 2 : 0;
				for (let x = -W * 1.2; x <= W * 1.2; x += stepX) {
					ctx.strokeText('InviteHeaven', x + off, y);
					ctx.fillText('InviteHeaven', x + off, y);
				}
				row++;
			}
			ctx.restore();
		};

		const drawCard = async (canvas: HTMLCanvasElement, id: string, maxW: number, guestName?: string) => {
			const tok = ++tokenN;
			tokens.set(canvas, tok);
			await fontsReady;
			const isHosts = id === 'hosts';
			const isGuest = id === 'guest';
			const lay: D = isHosts ? HL : isGuest ? GL : L;
			const img = await loadBg(lay.bg);
			if (tokens.get(canvas) !== tok) return;
			const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
			if (!img) {
				canvas.width = 540;
				canvas.height = 960;
				ctx.fillStyle = '#fcf9f1';
				ctx.fillRect(0, 0, 540, 960);
				ctx.fillStyle = '#1a1a1a';
				ctx.font = '16px sans-serif';
				ctx.textAlign = 'center';
				ctx.fillText('Card image not found.', 270, 440);
				ctx.fillText('Upload ' + lay.bg[lay.bg.length - 1] + ' to the public folder.', 270, 470);
				return;
			}
			const W = Math.min(img.naturalWidth, maxW);
			const H = Math.round((W * img.naturalHeight) / img.naturalWidth);
			canvas.width = W;
			canvas.height = H;
			ctx.imageSmoothingQuality = 'high';
			ctx.drawImage(img, 0, 0, W, H);
			if (isGuest) {
				const nm = guestName !== undefined ? guestName : (allGuests()[0] || {}).name;
				putGuest(ctx, 'Dear ' + (nm || 'Shaheer Aslam'), GL.field, W, H, !!nm);
			} else if (isHosts) {
				const rows = hostRows();
				const n = rows.length;
