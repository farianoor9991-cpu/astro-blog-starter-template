				<div style="display:grid;gap:8px;max-width:260px;margin-top:8px"><input id="cz-pin" type="password" inputmode="numeric" autocomplete="off" maxlength="4" placeholder="4-digit PIN" value="${esc(pinA)}" style="padding:10px 12px;border:1px solid #d9c8a6;border-radius:10px;font:inherit"><input id="cz-pin2" type="password" inputmode="numeric" autocomplete="off" maxlength="4" placeholder="Repeat PIN" value="${esc(pinB)}" style="padding:10px 12px;border:1px solid #d9c8a6;border-radius:10px;font:inherit"></div><p class="hint" id="pin-err" style="color:#b3261e" hidden></p></div>
