						if (input) input.value = v;
						S.active = d.ev;
						save();
						renderTabs();
						scheduleDraw();
					}
					break;
				}
				case 'hostsave': {
					const dr = S.hosts.draft || (S.hosts.draft = { name: '', phone: '' });
					const nm = String(dr.name).trim();
					const ph = String(dr.phone).trim();
					const eb = $('[data-err="host"]');
					if (!nm || ph.replace(/\D/g, '').length < 7) {
						if (eb) eb.textContent = !nm ? 'Please write the host name.' : 'Please write the phone number.';
						break;
					}
					if (S.hosts.list.length < MAX_HOSTS) S.hosts.list.push({ name: nm, phone: ph });
					S.hosts.draft = { name: '', phone: '' };
					S.active = 'hosts';
					refreshBody(3);
					updateSummaries();
					save();
					scheduleDraw();
					break;
				}
				case 'rmhost':
					S.hosts.list.splice(Number(d.i), 1);
					refreshBody(3);
					updateSummaries();
					save();
					scheduleDraw();
					break;
				case 'addlink':
					S.links.list.push({ id: uid(), label: '', cards: [] });
					refreshBody(4);
					save();
					break;
				case 'rmlink':
					S.links.list = S.links.list.filter((l: D) => l.id !== d.lk);
					if (!S.links.list.length) S.links.list.push({ id: uid(), label: '', cards: [] });
					refreshBody(4);
					save();
					break;
				case 'gmore':
					gMore = !gMore;
					refreshBody(5);
					break;
				case 'ltoggle':
					if (S.guests.on) {
						S.guests.on = false;
						save();
						updatePrice();
						refreshBody(4);
						renderTabs();
						scheduleDraw();
						updateSummaries();
					}
					break;
				case 'cmbhow':
					(window as any).IHCombos && (window as any).IHCombos.howItWorks();
					break;
				case 'gtoggle':
					S.guests.on = !S.guests.on;
					save();
					updatePrice();
					refreshBody(4);
					renderTabs();
					scheduleDraw();
					updateSummaries();
					break;
				case 'setup':
					S.setup = (b.dataset.v as string) === 'team' ? 'team' : 'self';
					save();
					refreshBody(6);
					updatePrice();
					break;
				case 'howto':
					howTo();
					break;
				case 'gpreview':
					openInEnvelope(Number(d.gi));
					break;
				case 'envelope': 	openInEnvelope(); 	break; case 'finish':
					finish();
					break;
				case 'preview':
					openModal();
					break;
				case 'draft':
					saveDraft();
					break;
				case 'restore':
					restoreDraft();
					break;
				case 'discard':
					try { localStorage.removeItem(DRAFT_KEY); } catch (e) {}
					($('#cz-draftbox') as HTMLElement).hidden = true;
					break;
				case 'close':
					closeModal();
					break;
			}
		});

		const go = (dir: number) => { 			const t = tabs(); 			if (t.length < 2) return; 			const i = Math.max(0, t.indexOf(S.active)); 			S.active = t[(i + dir + t.length) % t.length]; 			save(); 			renderTabs(); 			scheduleDraw(); 		}; 		const sheet = modal.querySelector('.cz-sheet') as HTMLElement; 		const mkArrow = (cls: string, txt: string, dir: number, aria: string) => { 			const b = document.createElement('button'); 			b.type = 'button'; 			b.className = 'sw ' + cls; 			b.innerHTML = txt; 			b.setAttribute('aria-label', aria); 			b.addEventListener('click', () => go(dir)); 			sheet.appendChild(b); 		}; 		mkArrow('sw-l', '&#8249;', -1, 'Previous card'); 		mkArrow('sw-r', '&#8250;', 1, 'Next card'); 		const pc = modal.querySelector('canvas') as HTMLCanvasElement; 		let sx = 0; 		pc.addEventListener('pointerdown', (e) => { 			sx = e.clientX; 		}); 		pc.addEventListener('pointerup', (e) => { 			const dx = e.clientX - sx; 			if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1); 		}); 		modal.addEventListener('click', (ev) => {
			if (ev.target === modal) closeModal();
		});
		document.addEventListener('keydown', (e) => {
			const gt = (e.target as HTMLElement).closest ? (e.target as HTMLElement).closest('[data-act="gtoggle"],[data-act="ltoggle"]') as HTMLElement | null : null;
			if (gt && gt.getAttribute('role') === 'checkbox' && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); gt.click(); return; }
			if (e.key === 'Escape') closeModal(); 			if (modal.classList.contains('open')) { 				if (e.key === 'ArrowLeft') go(-1); 				if (e.key === 'ArrowRight') go(1); 			}
		});

		/* ---------- draft (saved in this browser only) ---------- */
		const DRAFT_KEY = 'ih-haya-draft-v1';
		let draftTimer: any = 0;
		const saveDraft = () => {
			const b = ($('#cz-draft') || document.createElement('span')) as HTMLElement;
			try {
				localStorage.setItem(DRAFT_KEY, JSON.stringify({ S, custom: tpl.events.filter((e: D) => e.custom), at: Date.now() }));
				b.textContent = 'Draft saved';
			} catch (e) {
				b.textContent = 'Could not save';
			}
			clearTimeout(draftTimer);
			draftTimer = setTimeout(() => (b.textContent = 'Save draft'), 1800);
		};
		const buildSteps = () => {
			($('#cz-steps') as HTMLElement).innerHTML = STEPS.map(
				(s) =>
					`<section class="st" data-n="${s.n}"><button class="st-h" type="button" data-open="${s.n}" aria-expanded="false"><span class="st-n">${s.d}</span><span class="st-t"><b>${s.title}</b><small data-sum="${s.n}">${s.sub}</small></span><svg class="chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button><div class="st-b" data-body="${s.n}"></div></section>`
			).join('');
		};
		const restoreDraft = () => {
			try {
				const d = JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null');
				if (!d || !d.S) return;
				(d.custom || []).forEach((e: D) => {
					if (!tpl.events.some((x: D) => x.id === e.id)) tpl.events.push(e);
				});
				const fresh = blank();
				tpl.events.forEach((e: D) => (fresh.events[e.id] = { on: false, date: '', time: '', venue: '' }));
				S = Object.assign(fresh, d.S);
				buildSteps();
				ensureActive();
				openStep(S.open || 1);
				renderTabs();
				scheduleDraw();
				updateSummaries();
				updatePrice();
			} catch (e) {}
			($('#cz-draftbox') as HTMLElement).hidden = true;
		};

		/* ---------- start ---------- */
		($('#cz-name') as HTMLElement).textContent = tpl.name;
		buildSteps();
		updatePrice();
		try {
			if (localStorage.getItem(DRAFT_KEY)) ($('#cz-draftbox') as HTMLElement).hidden = false;
		} catch (e) {}
		root.addEventListener('input', (e) => {
			const t = e.target as HTMLInputElement;
			if (t.id === 'cz-pin' || t.id === 'cz-pin2') {
				t.value = t.value.replace(/\D/g, '').slice(0, 4);
				if (t.id === 'cz-pin') pinA = t.value;
				else pinB = t.value;
			}
		});
		loadBg(L.bg);
		loadBg(HL.bg);
		openStep(S.open || 1);
	}
