enue, tpl.sampleVenue)}</div> 						${i > 0 ? `<button type="button" class="lnk" data-act="samevenue" data-ev="${e.id}">Same venue as the event above</button>` : ''}${e.custom ? ` <button type="button" class="lnk" data-act="rmev" data-ev="${e.id}">Remove this event</button>` : ''} 					</div>`; 				}) 				.join(''); 			return ` 				<p class="hint">Tap the events you want cards for.</p> 				<div class="chips">${chips}<button type="button" class="chip" data-act="addev-open">+ Add event</button></div> ${S.addOpen ? '<div class="addev"><input data-addev maxlength="24" placeholder="Event name, e.g. Rukhsati" autocomplete="off"><button class="btn-o" type="button" data-act="addev">Add</button></div><p class="hint">The name appears on the card exactly as you write it.</p>' : ''} 				${blocks || '<p class="hint">Choose at least one event to continue.</p>'} 				<div class="err" data-err="2"></div> 				<div class="acts"><button class="btn-g" type="button" data-act="next" data-n="2">Continue to Step 3</button></div>`; 		};  		const body2Old = (): string => {
