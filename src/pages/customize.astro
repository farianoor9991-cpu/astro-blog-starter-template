S.open = n;
const anchor = document.querySelector('.st[data-n="' + n + '"]') as HTMLElement | null;
const topBefore = anchor ? anchor.getBoundingClientRect().top : 0;
if (n === 3 && S.hosts.want) S.active = 'hosts';
