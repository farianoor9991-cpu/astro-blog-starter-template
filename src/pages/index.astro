---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import DesignGrid from '../components/DesignGrid.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Ticker text: edit these lines to change what scrolls at the top
const ticker = [
	'✨ Digital Invitation Websites',
	'🌐 One Link, Every Detail',
	'💍 Wedding · Nikkah · Mayun · Mehndi · Baraat · Walima · Birthday · Hajj/Umrah · Aqeeqah · Baby Announcements',
	'📲 Customization Available',
];
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} ticker={ticker} variant="home">
	<Hero
		heading='Digital Invitations <br class="laptop-br" />For Your Memorable <br class="laptop-br" />Day!'
		text="Every celebration deserves a stunning start. We design elegant, personalized online invitations that are ready to share in hours. Crafted to be beautiful, effortless, and truly unforgettable for your special moments."
		buttonLabel="Check Our Catalogue"
		buttonHref="/catalogue"
		image="/hero-phone.jpg"
		imageAlt="Floral wedding invitation shown on a phone"
	/>

	

	<DesignGrid type="website" limit={8} moreHref="/catalogue" />
</PageLayout>
