---
import BaseHead from '../components/BaseHead.astro';
import DesignSections from '../components/DesignSections.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Ticker text: edit these lines to change what scrolls at the top
const items = [
	'✨ Digital Invitation Cards, Videos & Websites',
		'✨ Instant Downloads',
	'💍 Wedding · Mehndi · Walima · Birthday · Hajj/Umrah · Aqeeqah · Baby Announcements',
	'🎁 Order Today',
	'📲 Customization Available',
];
const loop = [...items, ...items];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="ticker" aria-label="Announcements">
			<div class="ticker-track">
				<div class="ticker-group">
					{loop.map((text) => <span class="tick">{text}</span>)}
				</div>
				<div class="ticker-group" aria-hidden="true">
					{loop.map((text) => <span class="tick">{text}</span>)}
				</div>
			</div>
		</div>

		<header class="site-header">
			<a href="/" class="logo" aria-label="Invite Hub home">
				<svg viewBox="0 0 40 40" width="34" height="34" fill="none" stroke="#D4A276" stroke-width="1.2">
					<ellipse cx="20" cy="10" rx="5" ry="8"></ellipse>
					<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(72 20 20)"></ellipse>
					<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(144 20 20)"></ellipse>
					<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(216 20 20)"></ellipse>
					<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(288 20 20)"></ellipse>
					<circle cx="20" cy="20" r="2" fill="#D4A276"></circle>
				</svg>
				<span class="logo-text">Invite<span class="hub">Hub</span></span>
			</a>

			<button class="menu-btn" aria-label="Open menu" aria-expanded="false">
				<span></span><span></span><span></span>
			</button>

			<nav class="site-nav">
				<a href="/">Home</a>
				<a href="/blog">Catalogue</a>
				<a href="/about">About</a>
			</nav>
		</header>

		<main class="ih-main">
			<section class="hero">
				<div class="hero-text">
					<h1>Digital Invitations <br class="laptop-br" />For Your Memorable <br class="laptop-br" />Day!</h1>

					<div class="copy">
						<p>
							Every celebration deserves a stunning start. We design elegant, personalized online invitations that are ready to share in hours. Crafted to be beautiful, effortless, and truly unforgettable for your special moments.
						</p>
						<a href="/blog" class="btn">Check Our Catalogue</a>
					</div>
				</div>

				<div class="visual">
					<img
						src="/hero-phone.jpg"
						alt="Floral wedding invitation shown on a phone"
						width="1228"
						height="1248"
					/>
				</div>
			</section>
			<DesignSections/>
		</main>

		<script>
			const btn = document.querySelector('.menu-btn');
			const nav = document.querySelector('.site-nav');
			btn?.addEventListener('click', () => {
				const open = nav?.classList.toggle('open');
				btn.setAttribute('aria-expanded', String(!!open));
			});
		</script>
	</body>
</html>

<style is:global>
	body {
		background: #fcf9f1 !important;
		margin: 0;
		padding: 0;
		font-family: 'Poppins', sans-serif;
		color: #5a5a5a;
		font-size: 16px;
		overflow-x: hidden;
	}
</style>

<style>
	/* Ticker bar */
	.ticker {
		background: #d4a276;
		color: #ffffff;
		overflow: hidden;
		height: 36px;
		display: flex;
		align-items: center;
	}
	.ticker-track {
		display: flex;
		width: max-content;
		animation: ticker-scroll 60s linear infinite;
	}
	.ticker:hover .ticker-track {
		animation-play-state: paused;
	}
	.ticker-group {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}
	.tick {
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		white-space: nowrap;
		margin-right: 48px;
	}
	@keyframes ticker-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ticker-track {
			animation: none;
		}
	}

	.site-header {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 20px;
		background: #fcf9f1;
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
		z-index: 10;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
	}
	.logo-text {
		font-family: 'Playfair Display', serif;
		font-weight: 700;
		font-size: 1.6rem;
		color: #1a1a1a;
	}
	.hub {
		color: #d4a276;
	}

	/* Hamburger (mobile) */
	.menu-btn {
		display: flex;
		flex-direction: column;
		gap: 6px;
		background: none;
		border: none;
		padding: 6px;
		cursor: pointer;
	}
	.menu-btn span {
		display: block;
		width: 28px;
		height: 2px;
		background: #1a1a1a;
	}
	.site-nav {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: #fcf9f1;
		padding: 10px 20px 18px;
		box-shadow: 0 10px 18px rgba(0, 0, 0, 0.06);
	}
	.site-nav.open {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.site-nav a {
		padding: 10px 0;
		text-decoration: none;
		color: #1a1a1a;
		font-weight: 500;
	}

	/* Mobile: text + button on first screen, top of the phone image peeks in */
	.ih-main {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px 40px;
		box-sizing: border-box;
	}
	.hero {
		display: block;
		text-align: center;
	}
	.hero-text {
		/* 75px header + 36px ticker + 30px = how much of the image peeks in */
		min-height: calc(100vh - 75px - 36px - 5px);
		min-height: calc(100svh - 75px - 36px - 5px);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 20px;
		padding: 16px 0;
		box-sizing: border-box;
	}
	.hero h1 {
		margin: 0;
		font-family: 'Playfair Display', serif;
		font-weight: 700;
		font-size: clamp(2rem, 9vw, 3.6rem);
		line-height: 1.2;
		color: #1a1a1a;
	}
	.copy p {
		margin: 0 0 24px;
		font-size: 1rem;
		line-height: 1.7;
		color: #5a5a5a;
	}
	.btn {
		display: inline-block;
		white-space: nowrap;
		background: #d4a276;
		color: #ffffff;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		font-size: 1rem;
		padding: 15px 32px;
		border-radius: 12px;
		text-decoration: none;
		outline: 1px solid rgba(212, 162, 118, 0.7);
		outline-offset: 4px;
		box-shadow: 0 8px 18px rgba(212, 162, 118, 0.35);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 24px rgba(212, 162, 118, 0.45);
	}
	.visual {
		display: flex;
		justify-content: center;
		margin-top: -25px;
	}
	.visual img {
		display: block;
		width: 100%;
		max-width: 440px;
		height: auto;
		-webkit-mask-image: radial-gradient(ellipse at 55% 55%, #000 55%, transparent 80%);
		mask-image: radial-gradient(ellipse at 55% 55%, #000 55%, transparent 80%);
	}

	/* Laptop and larger */
	@media (min-width: 800px) {
		.menu-btn {
			display: none;
		}
		.site-header {
			padding: 18px 60px;
		}
		.site-nav,
		.site-nav.open {
			display: flex;
			flex-direction: row;
			position: static;
			background: none;
			box-shadow: none;
			padding: 0;
			gap: 36px;
		}
		.ih-main {
			padding: 20px 60px 80px;
		}
		.hero {
			display: grid;
			grid-template-columns: 1fr 1fr;
			grid-template-areas:
				'title visual'
				'copy visual';
			column-gap: 40px;
			row-gap: 24px;
			align-items: center;
			text-align: left;
		}
		.hero-text {
			display: contents;
		}
		.hero h1 {
			grid-area: title;
			align-self: end;
			font-size: clamp(1.7rem, 3.3vw, 3.6rem);
		}
		.copy {
			grid-area: copy;
			align-self: start;
			max-width: 520px;
		}
		.copy p {
			font-size: 1.05rem;
			margin-bottom: 36px;
		}
		.btn {
			font-size: 1rem;
			padding: 16px 40px;
			outline-offset: 5px;
		}
		.visual {
			grid-area: visual;
			justify-content: flex-end;
			margin-top: 0px;
		}
		.visual img {
			width: 100%;
			max-width: none;
			-webkit-mask-image: radial-gradient(ellipse at 55% 55%, #000 55%, transparent 80%);
			mask-image: radial-gradient(ellipse at 55% 55%, #000 55%, transparent 80%);
			transform: translateX(30px, -20px);
		}
	}
</style>