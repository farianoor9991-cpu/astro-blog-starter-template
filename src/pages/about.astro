---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="About Us">
	<h1 class="pg-title">About Us</h1>
	<p class="pg-note">Coming soon.</p>
</PageLayout>

<style>
	.pg-title {
		margin: 0 0 14px;
		text-align: center;
		font-family: 'Playfair Display', serif;
		font-weight: 700;
		font-size: clamp(1.9rem, 8vw, 3rem);
		line-height: 1.2;
		color: #1a1a1a;
	}
	.pg-note {
		margin: 0;
		text-align: center;
		font-size: 14px;
		color: #5a5a5a;
	}
</style>
