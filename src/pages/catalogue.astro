---
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_TITLE } from '../consts';
import { categories, categoryOrder, designs } from '../data/designs';

const items = [
	'✨ Digital Invitation Websites, Videos & Cards',
	'✨ Instant Downloads',
	'💍 Wedding · Mehndi · Walima · Birthday · Hajj/Umrah · Aqeeqah · Baby Announcements',
	'📲 Customization Available',
];
const loop = [...items, ...items];

const tabs = categoryOrder.map((type) => ({
	type,
	tab: categories[type].tab,
	blurb: categories[type].blurb,
	count: designs[type].length,
occasions: ['Wedding', 'Nikkah', 'Mayun', 'Mehndi', 'Baraat', 'Walima', 'Birthday', 'Baby announcements', 'Aqeeqah', 'Hajj/Umrah'],
}));
const all = categoryOrder.flatMap((type) => designs[type]);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Catalogue | ${SITE_TITLE}`}
			description="Browse our invitation websites, cinematic videos and e-cards."
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" /> <link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="ticker" aria-label="Announcements">
			<div class="ticker-track">
				<div class="ticker-group">
					{loop.map((text) => <span class="tick">{text}</span>)}
				</div>
				<div class="ticker-group" aria-hidden="true">
					{loop.map((text) => <span class="tick">{text}</span>)}
				</div>
			</div>
		</div>

		<header class="site-header">
			<a href="/" class="logo" aria-label="Invite Heaven home">
				<svg viewBox="0 0 40 40" width="34" height="34" fill="none" stroke="#D4A276" stroke-width="1.2">
					<ellipse cx="20" cy="10" rx="5" ry="8"></ellipse>
					<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(72 20 20)"></ellipse>
					<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(144 20 20)"></ellipse>
					<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(216 20 20)"></ellipse>
					<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(288 20 20)"></ellipse>
					<circle cx="20" cy="20" r="2" fill="#D4A276"></circle>
				</svg>
				<span class="logo-text">Invite<span class="hub">Heaven</span></span>
			</a>

			<button class="menu-btn" aria-label="Open menu" aria-expanded="false">
				<span></span><span></span><span></span>
			</button>

			<nav class="site-nav">
				<a href="/">Home</a>
<a href="/catalogue" class="current">Catalogue</a>
<a href="/about">About</a>
			</nav>
		</header>

		<main class="cat">
			<h1 class="cat-title">Catalogue</h1>
			<p class="cat-blurb" id="cat-blurb">{tabs[0].blurb}</p>

			<div class="cat-tabs" role="tablist">
				{
					tabs.map((t, i) => (
						<button
							class:list={['cat-tab', { on: i === 0 }]}
							type="button"
							role="tab"
							data-type={t.type}
							data-blurb={t.blurb}
							aria-selected={i === 0 ? 'true' : 'false'}
						>
							{t.tab} <span class="cat-n">({t.count})</span>
						</button>
					))
				}
			</div>

			{
				tabs.map((t, i) => (
					<div class="cat-chips" data-chips={t.type} hidden={i !== 0}>
						<button class="chip on" type="button" data-occ="">All occasions</button>
						{t.occasions.map((o) => (
							<button class="chip" type="button" data-occ={o}>
								{o}
							</button>
						))}
					</div>
				))
			}

			<p class="cat-meta" id="cat-count"></p>

			<div class="cat-grid">
				{
					all.map((card) => (
						<article class="d-card" data-type={card.type} data-occ={card.occasion ?? ''} hidden={card.type !== 'website'}>
							<a
								class="d-img"
								href={card.link}
								target={card.link ? '_blank' : undefined}
								rel={card.link ? 'noopener' : undefined}
								aria-label={card.name}
							>
								<img src={card.image} alt={card.name} loading="lazy" />
								{card.type === 'video' && (
									<span class="d-play" aria-hidden="true">
										<svg viewBox="0 0 24 24" width="22" height="22">
											<path d="M8 5v14l11-7z" fill="#ffffff" />
										</svg>
									</span>
								)}
								{card.type === 'website' && <span class="d-live">LIVE</span>}
							</a>
							<div class="d-body">
								<p class="d-name">{card.name}</p>
								<p class="d-price">{card.price}</p>
								<div class="d-btns">
									<a class="d-btn d-outline" href={`/customize?design=${card.id}`}>Customize</a>
									<a class="d-btn d-fill" href={`/checkout?design=${card.id}`}>Buy Now</a>
								</div>
							</div>
						</article>
					))
				}
			</div>

			<p class="cat-empty" id="cat-empty" hidden>New designs are on the way. Please check back soon.</p>

			<div class="cat-more" hidden>
				<button class="more-btn" id="cat-more" type="button">Load more designs</button>
			</div>
	<section class="cat-next" id="cat-next">
		<h2 class="cat-next-title">Explore More</h2>
		<div class="cat-next-row">
			{
				tabs.map((t) => (
					<button class="next-card" type="button" data-goto={t.type}>
						{designs[t.type][0] && <img class="next-img" src={designs[t.type][0].image} alt="" loading="lazy" />}
						<span class="next-name">{categories[t.type].title}</span>
						<span class="next-price">{categories[t.type].price}</span>
						<span class="next-go">View {t.tab}</span>
					</button>
				))
			}
		</div>
	</section>
</main>
		<SiteFooter />

		<script>
			const btn = document.querySelector('.menu-btn');
const nav = document.querySelector('.site-nav');
const setOpen = (open: boolean) => {
	nav?.classList.toggle('open', open);
	btn?.setAttribute('aria-expanded', String(open));
};
btn?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
document.addEventListener('click', (e) => {
	if (btn?.contains(e.target as Node)) return;
	setOpen(false);
});
document.addEventListener('keydown', (e) => {
	if (e.key === 'Escape') setOpen(false);
});

			const PAGE = 8;
			const tabEls = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-tab'));
			const chipBoxes = Array.from(document.querySelectorAll<HTMLElement>('.cat-chips'));
			const cards = Array.from(document.querySelectorAll<HTMLElement>('.d-card'));
			const blurbEl = document.getElementById('cat-blurb');
			const countEl = document.getElementById('cat-count');
			const emptyEl = document.getElementById('cat-empty');
			const moreBtn = document.getElementById('cat-more');
			const moreBox = moreBtn?.parentElement;

			let type = 'website';
			let occ = '';
			let shown = PAGE;

			const render = () => {
				const matches = cards.filter((c) => c.dataset.type === type && (!occ || c.dataset.occ === occ));
				cards.forEach((c) => (c.hidden = true));
				matches.slice(0, shown).forEach((c) => (c.hidden = false));
				if (countEl) countEl.textContent = `${matches.length} design${matches.length === 1 ? '' : 's'}`;
				if (emptyEl) emptyEl.hidden = matches.length > 0;
				if (moreBox) moreBox.hidden = matches.length <= shown;
			};

			const setType = (t: string) => {
				type = t;
				occ = '';
				shown = PAGE;
				tabEls.forEach((el) => {
					const on = el.dataset.type === t;
					el.classList.toggle('on', on);
					el.setAttribute('aria-selected', String(on));
					if (on && blurbEl) blurbEl.textContent = el.dataset.blurb ?? '';
				});
				chipBoxes.forEach((box) => {
					box.hidden = box.dataset.chips !== t;
					box.querySelectorAll('.chip').forEach((c, n) => c.classList.toggle('on', n === 0));
				});
				history.replaceState(null, '', `?type=${t}`);
				render();
			};

			tabEls.forEach((el) => el.addEventListener('click', () => setType(el.dataset.type ?? 'website')));

			chipBoxes.forEach((box) =>
				box.addEventListener('click', (e) => {
					const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
					if (!chip) return;
					box.querySelectorAll('.chip').forEach((c) => c.classList.toggle('on', c === chip));
					occ = chip.dataset.occ ?? '';
					shown = PAGE;
					render();
				})
			);

			moreBtn?.addEventListener('click', () => {
				shown += PAGE;
				render();
			});

			const wanted = new URLSearchParams(location.search).get('type');
			setType(tabEls.some((t) => t.dataset.type === wanted) ? (wanted as string) : 'website');
</script>

<script>
	const nextCards = Array.from(document.querySelectorAll<HTMLElement>('.next-card'));
	const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-tab'));

	const sync = () => {
		const current = tabBtns.find((b) => b.classList.contains('on'))?.dataset.type;
		nextCards.forEach((c) => (c.hidden = c.dataset.goto === current));
	};

	tabBtns.forEach((b) => b.addEventListener('click', () => setTimeout(sync, 0)));
	nextCards.forEach((c) =>
		c.addEventListener('click', () => {
			tabBtns.find((b) => b.dataset.type === c.dataset.goto)?.click();
			document.querySelector('.cat-title')?.scrollIntoView({ behavior: 'smooth' });
		})
	);
	setTimeout(sync, 0);
</script>
</body>
</html>

<style is:global>
	body {
		background: #fcf9f1 !important;
		margin: 0;
		padding: 0;
		font-family: 'Poppins', sans-serif;
		color: #5a5a5a;
		font-size: 16px;
		overflow-x: hidden;
	}
	[hidden] {
		display: none !important;
	}
</style>

<style>
	/* Ticker bar */
	.ticker {
		background: #d4a276;
		color: #ffffff;
		overflow: hidden;
		height: 36px;
		display: flex;
		align-items: center;
	}
	.ticker-track {
		display: flex;
		width: max-content;
		animation: ticker-scroll 60s linear infinite;
	}
	.ticker:hover .ticker-track {
		animation-play-state: paused;
	}
	.ticker-group {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}
	.tick {
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		white-space: nowrap;
		margin-right: 48px;
	}
	@keyframes ticker-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ticker-track {
			animation: none;
		}
	}

	/* Header */
	.site-header {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 20px;
		background: #fcf9f1;
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
		z-index: 30;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
	}
	.logo-text {
		font-family: 'Playfair Display', serif;
		font-weight: 700;
		font-size: 1.6rem;
		color: #1a1a1a;
	}
	.hub {
		color: #d4a276;
	}
	.menu-btn {
		display: flex;
		flex-direction: column;
		gap: 6px;
		background: none;
		border: none;
		padding: 6px;
		cursor: pointer;
	}
	.menu-btn span {
		display: block;
		width: 28px;
		height: 2px;
		background: #1a1a1a;
	}
	.site-nav {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: #fcf9f1;
		padding: 10px 20px 18px;
		box-shadow: 0 10px 18px rgba(0, 0, 0, 0.06);
	}
	.site-nav.open {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.site-nav a {
		padding: 10px 0;
		text-decoration: none;
		color: #1a1a1a;
		font-weight: 500;
	}

	/* Catalogue page */
	.cat {
		width: 100%;
		box-sizing: border-box;
		max-width: 1100px;
margin: 0 auto;
		padding: 44px 20px 70px;
	}
	.cat-title {
		margin: 0 0 14px;
		text-align: center;
		font-family: 'Playfair Display', serif;
		font-weight: 700;
		font-size: clamp(1.9rem, 8vw, 3rem);
		line-height: 1.2;
		color: #1a1a1a;
	}
	.cat-blurb {
		margin: 0 auto 24px;
		padding: 0 6px;
		max-width: 560px;
		text-align: center;
		font-size: 14px;
		line-height: 1.75;
		color: #5a5a5a;
	}

	/* Tabs (stay at the top while scrolling) */
	.cat-tabs {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		justify-content: center;
		gap: 8px;
		padding: 10px 0;
		background: #fcf9f1;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.cat-tabs::-webkit-scrollbar {
		display: none;
	}
	.cat-tab {
		flex: 0 0 auto;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		font-size: 13px;
		color: #1a1a1a;
		background: transparent;
		border: 1.5px solid #1a1a1a;
		border-radius: 999px;
		padding: 9px 16px;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.cat-tab.on {
		background: #d4a276;
		border-color: #d4a276;
		color: #ffffff;
	}

	/* Occasion chips */
	.cat-chips {
		display: flex;
		gap: 8px;
		padding: 8px 2px 12px;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.cat-chips::-webkit-scrollbar {
		display: none;
	}
	.chip {
		flex: 0 0 auto;
		font-family: 'Poppins', sans-serif;
		font-size: 12px;
		color: #5a5a5a;
		background: #ffffff;
		border: none;
		border-radius: 999px;
		padding: 7px 14px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
		cursor: pointer;
	}
	.chip.on {
		color: #1a1a1a;
		font-weight: 500;
		box-shadow: inset 0 0 0 1px #d4a276, 0 2px 8px rgba(0, 0, 0, 0.06);
	}
	.cat-meta {
		margin: 4px 0 14px;
		text-align: center;
		font-size: 13px;
		color: #5a5a5a;
	}

	/* Grid */
	.cat-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}
	.cat-empty {
		margin: 30px 0 0;
		text-align: center;
		font-size: 14px;
		color: #5a5a5a;
	}
	.cat-more {
		display: flex;
		justify-content: center;
		margin-top: 28px;
	}
	.more-btn {
		background: #d4a276;
		color: #ffffff;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		font-size: 14px;
		padding: 12px 36px;
		border: none;
		border-radius: 999px;
		cursor: pointer;
		box-shadow: 0 8px 18px rgba(212, 162, 118, 0.35);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.more-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 24px rgba(212, 162, 118, 0.45);
	}

	/* Cards */
	.d-card {
		background: #ffffff;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
	}
	.d-img {
		display: block;
		position: relative;
		aspect-ratio: 9 / 16;
		background: #fcf9f1;
	}
	.d-img img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 0;
	}
	.d-play {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: #d4a276;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
	}
	.d-play svg {
		margin-left: 3px;
	}
	.d-live {
		position: absolute;
		top: 10px;
		right: 10px;
		display: flex;
		align-items: center;
		gap: 5px;
		background: #d4a276;
		color: #ffffff;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		font-size: 11px;
		letter-spacing: 0.06em;
		padding: 4px 10px;
		border-radius: 999px;
	}
	.d-live::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #ffffff;
	}
	.d-body {
		padding: 12px 10px 14px;
		text-align: center;
	}
	.d-name {
		margin: 0 0 4px;
		min-height: calc(1.4em * 2);
		font-family: 'Poppins', sans-serif;
		font-weight: 400;
		font-size: 12px;
		line-height: 1.4;
		color: #5a5a5a;
	}
	.d-price {
		margin: 0 0 10px;
		font-family: 'Poppins', sans-serif;
		font-weight: 700;
		font-size: 16px;
		color: #1a1a1a;
	}
	.d-btns {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.d-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 36px;
		box-sizing: border-box;
		border-radius: 999px;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		font-size: 12px;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 0.2s ease;
	}
	.d-btn:hover {
		transform: translateY(-1px);
	}
	.d-outline {
		border: 1.5px solid #1a1a1a;
		color: #1a1a1a;
		background: transparent;
	}
	.d-fill {
		border: 1.5px solid #d4a276;
		background: #d4a276;
		color: #ffffff;
	}

	/* Laptop */
	@media (min-width: 800px) {
		.menu-btn {
			display: none;
		}
		.site-header {
			padding: 18px 60px;
		}
		.site-nav,
		.site-nav.open {
			display: flex;
			flex-direction: row;
			position: static;
			background: none;
			box-shadow: none;
			padding: 0;
			gap: 36px;
		}
		.cat {
			padding: 64px 60px 90px;
		}
		.cat-blurb {
			font-size: 15px;
			margin-bottom: 30px;
		}
		.cat-tab {
			font-size: 14px;
			padding: 10px 22px;
		}
		.cat-chips {
			justify-content: center;
			flex-wrap: wrap;
			overflow: visible;
		}
		.cat-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 16px;
		}
		.d-body {
			padding: 16px 14px 18px;
		}
		.d-name {
			min-height: 0;
			font-size: 13px;
		}
		.d-price {
			margin-bottom: 12px;
		}
		.d-btns {
			flex-direction: row;
			gap: 8px;
		}
		.d-btn {
			flex: 1;
			width: auto;
			height: 38px;
			font-size: 12.5px;
		}
	}
	@media (min-width: 1000px) {
		.cat-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.cat {
		overflow-x: clip;
	}
	.cat-tabs {
		flex-wrap: wrap;
		overflow: visible;
	}
	.cat-tab {
		font-size: 12.5px;
		padding: 8px 13px;
	}
	.site-nav a.current {
		color: #d4a276;
	}
	@media (min-width: 800px) {
		.cat-tab {
			font-size: 14px;
			padding: 10px 22px;
		}
		.d-btns {
			flex-direction: column;
			gap: 10px;
		}
		.d-btn {
			flex: none;
			width: 100%;
			height: 40px;
			font-size: 13px;
		}
	}
	/* Occasion chips: wrap, no scrolling */
	.cat-chips {
		flex-wrap: wrap;
		justify-content: center;
		overflow: visible;
	}

	/* Explore more (the other two categories) */
	.cat-next {
		margin-top: 56px;
		padding-top: 40px;
		border-top: 1px solid rgba(26, 26, 26, 0.12);
		text-align: center;
	}
	.cat-next-title {
