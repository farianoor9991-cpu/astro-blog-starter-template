---
import PageLayout from '../layouts/PageLayout.astro';
import CatalogueView from '../components/CatalogueView.astro';

// Ticker text for this page: edit these lines to change what scrolls at the top
const ticker = [
	'✨ Digital Invitation Websites',
	'🌐 One Link, Every Detail',
	'💍 Wedding · Nikkah · Mayun · Mehndi · Baraat · Walima · Baat Pakki · Engagement · Bridal Shower',
	'📲 Customization Available',
];
---

<PageLayout
	title="Catalogue"
	description="Browse our elegant invitation websites for weddings and celebrations."
	ticker={ticker}
>
	<CatalogueView type="website" />
</PageLayout>
