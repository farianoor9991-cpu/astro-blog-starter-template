---
import { haya } from '../data/templates/haya';
import { hayaEnvelope, hayaDemoInvitation } from '../data/haya-envelope';

// The engine reads this block: the look (design), the card layout (template) and the guest's details (invitation).
const config = {
	design: hayaEnvelope,
	template: haya,
	invitation: hayaDemoInvitation,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex" />
		<title>Haya Invitation (Demo)</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Berkshire+Swash&family=Unna:wght@400;700&family=Playfair+Display:wght@700&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/envelope.css?v=9" />
	</head>
	<body>
		<div id="env-root"></div>
		<script is:inline id="env-config" type="application/json" set:html={JSON.stringify(config)} />
		<script is:inline>
			// Preview from the customize form: show the guest's chosen events instead of the sample ones
			(function () {
				try {
					if (new URLSearchParams(location.search).get('preview') !== '1') return;
					var raw = localStorage.getItem('ih-haya-preview');
					if (!raw) return;
					var d = JSON.parse(raw);
					if (!d || !d.events || !d.events.length) return;
					var el = document.getElementById('env-config');
					var cfg = JSON.parse(el.textContent);
					var gi = new URLSearchParams(location.search).get('g');
					var g = gi !== null && d.guests && d.guests.length ? d.guests[Math.min(Number(gi) || 0, d.guests.length - 1)] : null;
					cfg.invitation = { couple: d.couple, events: g ? g.events : d.events, hosts: d.hosts || [], guest: g ? g.name : '' };
					el.textContent = JSON.stringify(cfg);
				} catch (e) {}
			})();
		</script>
		<script is:inline src="/gsap.min.js"></script>
		<script is:inline>
			(function () {
				try {
					if (new URLSearchParams(location.search).get('preview') !== '1') return;
					var w = Math.min(window.innerWidth, 430) / 3;
					var h = w * 0.62;
					var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="' + w + '" height="' + h * 2 + '">' +
						[[w / 2, h * 0.5], [0, h * 1.5], [w, h * 1.5]].map(function (p) {
							return '<text x="' + p[0] + '" y="' + p[1] + '" font-family="Arial,sans-serif" font-weight="700" font-size="' + w * 0.2 + '" text-anchor="middle" fill="rgba(255,255,255,0.5)" stroke="rgba(39,96,65,0.4)" stroke-width="1" transform="rotate(-28 ' + p[0] + ' ' + p[1] + ')">InviteHeaven</text>';
						}).join('') + '</svg>';
					var d = document.createElement('div');
					d.style.cssText = 'position:fixed;inset:0;z-index:99999;pointer-events:none;background:url("data:image/svg+xml,' + encodeURIComponent(svg) + '") repeat;';
					document.body.appendChild(d);
				} catch (e) {}
			})();
		</script>
		<script is:inline src="/envelope-engine.js?v=11"></script>
	</body>
</html>
