---
import { haya } from '../data/templates/haya';
import { hayaEnvelope, hayaDemoInvitation } from '../data/haya-envelope';

// The engine reads this block: the look (design), the card layout (template) and the guest's details (invitation).
const config = {
	design: hayaEnvelope,
	template: haya,
	invitation: hayaDemoInvitation,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex" />
		<title>Haya Invitation (Demo)</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Berkshire+Swash&family=Unna:ital,wght@0,400;0,700;1,600&family=Playfair+Display:wght@700&family=Pinyon+Script&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/envelope.css?v=26" />
		<link rel="stylesheet" href="/ih-footer.css?v=6" />
	</head>
	<body>
		<div id="env-root"></div>
		<script is:inline id="env-config" type="application/json" set:html={JSON.stringify(config)} />
		<script is:inline>
			// Preview from the customize form: show the guest's chosen events instead of the sample ones
			(function () {
				try {
					if (new URLSearchParams(location.search).get('preview') !== '1') return;
					var raw = localStorage.getItem('ih-haya-preview');
					if (!raw) return;
					var d = JSON.parse(raw);
					if (!d || !d.events || !d.events.length) return;
					var el = document.getElementById('env-config');
					var cfg = JSON.parse(el.textContent);
					var gi = new URLSearchParams(location.search).get('g');
					var g = gi !== null && d.guests && d.guests.length ? d.guests[Math.min(Number(gi) || 0, d.guests.length - 1)] : null;
					cfg.watermark = !/[?&]nowm=1/.test(location.search);
					cfg.invitation = { couple: d.couple, events: g ? g.events : d.events, hosts: d.hosts || [], guest: g ? g.name : '', seatRows: [{ id: 'baraat', n: 1 }, { id: 'nikkah', n: 2 }, { id: 'mehndi', n: 0 }, { id: 'walima', n: 0 }], footer: { mode: 'couple', family: '' } };
					el.textContent = JSON.stringify(cfg);
				} catch (e) {}
			})();
		</script>
		<script is:inline src="/ih-footer.js?v=5"></script>
		<script is:inline src="/gsap.min.js"></script>
		<script is:inline src="/envelope-engine.js?v=37"></script>
	</body>
</html>
