---
import { haya } from '../data/templates/haya';
import { hayaEnvelope, hayaDemoInvitation } from '../data/haya-envelope';

// The engine reads this block: the look (design), the card layout (template) and the guest's details (invitation).
const config = {
	design: hayaEnvelope,
	template: haya,
	invitation: hayaDemoInvitation,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex" />
		<title>Invitation</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Berkshire+Swash&family=Unna:wght@400;700&family=Playfair+Display:wght@700&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/envelope.css?v=9" />
	</head>
	<body>
		<div id="env-root"></div>
		<script is:inline id="env-config" type="application/json" set:html={JSON.stringify(config)} />
		<p id="inv-msg" style="display:none;font-family:Poppins,sans-serif;text-align:center;padding:40px 20px;color:#5a5a5a"></p>
		<script is:inline>
			// Loads this guest's invitation from the saved order, then starts the envelope
			(function () {
				var q = new URLSearchParams(location.search);
				var el = document.getElementById('env-config');
				var msg = document.getElementById('inv-msg');
				function fail(t) {
					msg.textContent = t;
					msg.style.display = 'block';
				}
				function load(src, cb) {
					var s = document.createElement('script');
					s.src = src;
					s.onload = cb;
					document.body.appendChild(s);
				}
				fetch('/api/invite?' + q.toString().replace(/&?v=\d+/, ''), { cache: 'no-store' })
					.then(function (r) {
						if (!r.ok) throw new Error('x');
						return r.json();
					})
					.then(function (d) {
						var cfg = JSON.parse(el.textContent);
						cfg.invitation = { couple: d.couple, events: d.events, hosts: d.hosts || [], guest: d.guest || '' };
						el.textContent = JSON.stringify(cfg);
						document.title = d.couple.brideName.split(' ')[0] + ' & ' + d.couple.groomName.split(' ')[0] + ' | Invitation';
						load('/gsap.min.js', function () {
							load('/envelope-engine.js?v=13');
						});
					})
					.catch(function () {
						fail('This invitation link is not available. Please check the link you received.');
					});
			})();
		</script>
	</body>
</html>
