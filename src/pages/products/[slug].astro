---
import PageLayout from '../../layouts/PageLayout.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
	return Object.keys(products).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const p = products[slug as string];
---

<PageLayout title={`${p.name} | ${p.category}`} description={p.tagline} showReviews={false}>
	<div class="pp">
		<section class="hero">
			<div class="hero-img">
				<img src={p.image} alt={`${p.name} invitation`} />
			</div>
			<div class="hero-text">
				<span class="eyebrow">{p.category}</span>
				<h1>{p.name}</h1>
				<p class="tag">{p.tagline}</p>
				<div class="price-box">
					<p class="price">{p.priceRange}</p>
					<p class="price-note">{p.priceNote}</p>
				</div>
				<div class="btns">
					<a class="btn fill" href={`/customize?design=${p.designId}`}>Customize Now</a>
					<a class="btn line" href={p.demo} target="_blank" rel="noopener">View Live Demo</a>
				</div>
			</div>
		</section>

		<section class="block">
			<h2>About {p.name}</h2>
			<p class="lead">{p.about}</p>
		</section>

		<section class="block">
			<h2>What you get</h2>
			<div class="grid">
				{
					p.features.map((f) => (
						<div class="card">
							<h3>{f.title}</h3>
							<p>{f.text}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="block">
			<h2>Events you can include</h2>
			<div class="chips">
				{p.events.map((e) => <span class="chip">{e}</span>)}
			</div>
		</section>

		<section class="block">
			<h2>How it works</h2>
			<ol class="steps">
				{
					p.steps.map((s, i) => (
						<li>
							<span class="n">{i + 1}</span>
							<div>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<section class="block">
			<h2>Ways to share</h2>
			<div class="grid three">
				{
					p.linkOptions.map((o) => (
						<div class="card">
							<h3>{o.title}</h3>
							<p>{o.text}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="block">
			<h2>Pricing</h2>
			<div class="table">
				{
					p.prices.map((r) => (
						<div class="row">
							<div>
								<b>{r.item}</b>
								{r.note && <small>{r.note}</small>}
							</div>
							<span>{r.price}</span>
						</div>
					))
				}
			</div>
			<p class="fine">Your total updates automatically as you choose cards and add-ons in the form.</p>
		</section>

		<section class="block">
			<h2>Questions</h2>
			<div class="faqs">
				{
					p.faqs.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))
				}
			</div>
		</section>

		<section class="cta">
			<h2>Ready to create your {p.name} invitation?</h2>
			<div class="btns">
				<a class="btn fill" href={`/customize?design=${p.designId}`}>Customize Now</a>
				<a class="btn line" href={p.demo} target="_blank" rel="noopener">View Live Demo</a>
			</div>
		</section>
	</div>
</PageLayout>

<style>
	.pp {
		max-width: 1040px;
		margin: 0 auto;
		padding: 24px 16px 48px;
		color: #3d3d3d;
	}
	.hero {
		display: grid;
		gap: 24px;
		align-items: center;
	}
	.hero-img img {
		width: 100%;
		max-width: 340px;
		display: block;
		margin: 0 auto;
		border-radius: 18px;
		box-shadow: 0 14px 34px rgba(0, 0, 0, 0.16);
	}
	.eyebrow {
		display: inline-block;
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #b8793c;
		font-weight: 600;
	}
	h1 {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2.2rem, 8vw, 3.2rem);
		margin: 6px 0 8px;
		color: #276041;
		line-height: 1.1;
	}
	.tag {
		margin: 0 0 16px;
		font-size: 16px;
		line-height: 1.6;
	}
	.price-box {
		padding: 14px 16px;
		background: #fff;
		border: 1px solid #eadfc9;
		border-radius: 14px;
		margin-bottom: 18px;
	}
	.price {
		margin: 0;
		font-size: 22px;
		font-weight: 700;
		color: #1a1a1a;
	}
	.price-note {
		margin: 4px 0 0;
		font-size: 13px;
		color: #6b6b6b;
	}
	.btns {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.btn {
		display: inline-block;
		padding: 13px 22px;
		border-radius: 999px;
		font-weight: 600;
		font-size: 15px;
		text-decoration: none;
		text-align: center;
	}
	.btn.fill {
		background: #276041;
		color: #fff;
	}
	.btn.line {
		border: 1.5px solid #276041;
		color: #276041;
		background: transparent;
	}
	.block {
		margin-top: 44px;
	}
	h2 {
		font-family: 'Playfair Display', serif;
		font-size: 1.6rem;
		color: #1a1a1a;
		margin: 0 0 14px;
	}
	.lead {
		margin: 0;
		font-size: 16px;
		line-height: 1.75;
	}
	.grid {
		display: grid;
		gap: 12px;
	}
	.card {
		background: #fff;
		border: 1px solid #eadfc9;
		border-radius: 14px;
		padding: 16px;
	}
	h3 {
		margin: 0 0 6px;
		font-size: 16px;
		color: #276041;
	}
	.card p,
	.steps p {
		margin: 0;
		font-size: 14.5px;
		line-height: 1.65;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.chip {
		padding: 8px 16px;
		border-radius: 999px;
		background: #fff;
		border: 1px solid #d9c8a6;
		font-size: 14px;
		color: #276041;
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 14px;
	}
	.steps li {
		display: flex;
		gap: 14px;
		align-items: flex-start;
	}
	.n {
		flex: 0 0 34px;
		height: 34px;
		border-radius: 50%;
		background: #276041;
		color: #fff;
		display: grid;
		place-items: center;
		font-weight: 700;
	}
	.table {
		background: #fff;
		border: 1px solid #eadfc9;
		border-radius: 14px;
		overflow: hidden;
	}
	.row {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding: 14px 16px;
		border-bottom: 1px solid #f1e8d6;
		align-items: center;
	}
	.row:last-child {
		border-bottom: 0;
	}
	.row small {
		display: block;
		color: #6b6b6b;
		font-size: 12.5px;
		margin-top: 2px;
	}
	.row span {
		font-weight: 700;
		white-space: nowrap;
		color: #1a1a1a;
	}
	.fine {
		font-size: 13px;
		color: #6b6b6b;
		margin: 10px 2px 0;
	}
	.faqs details {
		background: #fff;
		border: 1px solid #eadfc9;
		border-radius: 12px;
		padding: 12px 16px;
		margin-bottom: 8px;
	}
	.faqs summary {
		cursor: pointer;
		font-weight: 600;
		color: #1a1a1a;
	}
	.faqs p {
		margin: 8px 0 0;
		font-size: 14.5px;
		line-height: 1.65;
	}
	.cta {
		margin-top: 48px;
		text-align: center;
		padding: 28px 16px;
		background: #fff;
		border: 1px solid #eadfc9;
		border-radius: 18px;
	}
	.cta .btns {
		justify-content: center;
	}
	@media (min-width: 760px) {
		.hero {
			grid-template-columns: 340px 1fr;
			gap: 48px;
		}
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.grid.three {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
