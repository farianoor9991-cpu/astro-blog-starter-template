---
import { occasions } from '../data/occasions';
import type { DesignType } from '../data/designs';

interface Props {
	type: DesignType;
	href: string;
}
const { type, href } = Astro.props;
const list = occasions[type];
---

<div class="oc" aria-label="Shop by occasion">
	<a class="chip on" href={href}>All occasions</a>
	{
		list.map((o) => (
			<a class="chip" href={`${href}?occasion=${encodeURIComponent(o)}`}>
				{o}
			</a>
		))
	}
</div>

<style>
	.oc {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin: 0 auto 26px;
		max-width: 760px;
	}
	.chip {
		display: inline-block;
		font-family: 'Poppins', sans-serif;
		font-size: 12px;
		color: #5a5a5a;
		background: #ffffff;
		border-radius: 999px;
		padding: 7px 14px;
		text-decoration: none;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
		transition: transform 0.2s ease;
	}
	.chip:hover {
		transform: translateY(-1px);
		color: #1a1a1a;
	}
	.chip.on {
		color: #1a1a1a;
		font-weight: 500;
		box-shadow: inset 0 0 0 1px #d4a276, 0 2px 8px rgba(0, 0, 0, 0.06);
	}
</style>
