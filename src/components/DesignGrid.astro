---
import { categories, designs, type DesignType } from '../data/designs';

interface Props {
	type: DesignType;
	limit?: number;
	moreHref: string;
	moreLabel?: string;
	secondHref?: string;
	secondLabel?: string;
}
const { type, limit = 8, moreHref, moreLabel = 'View more', secondHref, secondLabel } = Astro.props;
const cat = categories[type];
const items = designs[type].slice(0, limit);
---

{
	items.length > 0 && (
		<section class="gs" id={type}>
			<h2 class="gs-title">{cat.title}</h2>
<p class="gs-blurb">{cat.blurb}</p>
<slot name="filters" />
			<div class="gs-grid">
				{items.map((card) => (
					<article class="d-card">
						<a
							class="d-img"
							href={card.link}
							target={card.link ? '_blank' : undefined}
							rel={card.link ? 'noopener' : undefined}
							aria-label={card.name}
						>
							<img src={card.image} alt={card.name} loading="lazy" />
							{type === 'website' && <span class="d-live">LIVE</span>}
						</a>
						<div class="d-body">
							<p class="d-name">{card.name}</p>
							<p class="d-price">{card.price}</p>
							<div class="d-btns">
								<a class="d-btn d-outline" href={`/customize?design=${card.id}`}>Customize</a>
								<a class="d-btn d-fill" href={`/checkout?design=${card.id}`}>Buy Now</a>
							</div>
						</div>
					</article>
				))}
			</div>

			<div class="gs-more">
				<a class="gs-btn" href={moreHref}>{moreLabel}</a>
				{secondHref && secondLabel && (
					<a class="gs-btn gs-btn-outline" href={secondHref}>{secondLabel}</a>
				)}
			</div>
		</section>
	)
}

<style>
	.gs {
		margin-top: 64px;
		text-align: center;
	}
	.gs-title {
		margin: 0 0 14px;
		font-family: 'Playfair Display', serif;
		font-weight: 700;
		font-size: clamp(1.6rem, 7.5vw, 2.8rem);
		line-height: 1.2;
		color: #1a1a1a;
	}
	.gs-blurb {
		margin: 0 auto 28px;
		padding: 0 6px;
		max-width: 560px;
		font-family: 'Poppins', sans-serif;
		font-weight: 400;
		font-size: 14px;
		line-height: 1.75;
		color: #5a5a5a;
	}

	/* Mobile: 2 columns */
	.gs-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}
	.d-card {
		background: #ffffff;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
	}
	.d-img {
		display: block;
		position: relative;
		aspect-ratio: 9 / 16;
		background: #fcf9f1;
	}
	.d-img img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 0;
	}
	.d-live {
		position: absolute;
		top: 10px;
		right: 10px;
		display: flex;
		align-items: center;
		gap: 5px;
		background: #d4a276;
		color: #ffffff;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		font-size: 11px;
		letter-spacing: 0.06em;
		padding: 4px 10px;
		border-radius: 999px;
	}
	.d-live::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #ffffff;
	}
	.d-body {
		padding: 12px 10px 14px;
		text-align: center;
	}
	.d-name {
		margin: 0 0 4px;
		min-height: calc(1.4em * 2);
		font-family: 'Poppins', sans-serif;
		font-weight: 400;
		font-size: 12px;
		line-height: 1.4;
		color: #5a5a5a;
	}
	.d-price {
		margin: 0 0 10px;
		font-family: 'Poppins', sans-serif;
		font-weight: 700;
		font-size: 16px;
		color: #1a1a1a;
	}
	/* Customize on top, Buy Now below (mobile and laptop) */
	.d-btns {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.d-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 36px;
		box-sizing: border-box;
		border-radius: 999px;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		font-size: 12px;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 0.2s ease;
	}
	.d-btn:hover {
		transform: translateY(-1px);
	}
	.d-outline {
		border: 1.5px solid #1a1a1a;
		color: #1a1a1a;
		background: transparent;
	}
	.d-fill {
		border: 1.5px solid #d4a276;
		background: #d4a276;
		color: #ffffff;
	}

	/* Buttons under the grid */
	.gs-more {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 28px;
	}
	.gs-btn {
		display: inline-block;
		background: #d4a276;
		color: #ffffff;
		border: 1.5px solid #d4a276;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		font-size: 14px;
		padding: 12px 36px;
		border-radius: 999px;
		text-decoration: none;
		box-shadow: 0 8px 18px rgba(212, 162, 118, 0.35);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.gs-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 24px rgba(212, 162, 118, 0.45);
	}
	.gs-btn-outline {
		background: transparent;
		color: #1a1a1a;
		border-color: #1a1a1a;
		box-shadow: none;
	}
	.gs-btn-outline:hover {
		box-shadow: none;
	}

	/* Laptop: 4 columns */
	@media (min-width: 800px) {
		.gs {
			margin-top: 90px;
		}
		.gs-blurb {
			font-size: 15px;
			margin-bottom: 36px;
		}
		.gs-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 16px;
			max-width: 1040px;
			margin: 0 auto;
		}
		.d-body {
			padding: 16px 14px 18px;
		}
		.d-name {
			min-height: 0;
			font-size: 13px;
		}
		.d-price {
			margin-bottom: 12px;
		}
		.d-btns {
			gap: 10px;
		}
		.d-btn {
			height: 40px;
			font-size: 13px;
		}
		.gs-more {
			margin-top: 36px;
		}
	}
</style>
