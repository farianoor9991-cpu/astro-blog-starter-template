---
interface Props {
	section?: 'websites' | 'ecards';
}
const { section = 'websites' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCards = section === 'ecards';
const homeHref = isCards ? '/e-cards' : '/';
const websitesOption = { label: 'Website Invitations', href: '/catalogue' };
const cardsOption = { label: 'E-Cards', href: '/e-cards' };
// The product you are currently in is listed first
const options = isCards ? [cardsOption, websitesOption] : [websitesOption, cardsOption];
---

<header class="site-header">
	<a href={homeHref} class="logo" aria-label="Invite Heaven home">
		<svg viewBox="0 0 40 40" width="34" height="34" fill="none" stroke="#D4A276" stroke-width="1.2">
			<ellipse cx="20" cy="10" rx="5" ry="8"></ellipse>
			<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(72 20 20)"></ellipse>
			<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(144 20 20)"></ellipse>
			<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(216 20 20)"></ellipse>
			<ellipse cx="20" cy="10" rx="5" ry="8" transform="rotate(288 20 20)"></ellipse>
			<circle cx="20" cy="20" r="2" fill="#D4A276"></circle>
		</svg>
		<span class="logo-text">Invite<span class="hub">Heaven</span></span>
	</a>

	<button class="menu-btn" aria-label="Open menu" aria-expanded="false">
		<span></span><span></span><span></span>
	</button>

	<nav class="site-nav" aria-label="Main menu">
		<a href={homeHref} class:list={[{ current: path === homeHref }]}>Home</a>
		<p class="nav-group">Catalogue</p>
		<div class="nav-sub">
			{
				options.map((o) => (
					<a href={o.href} class:list={[{ current: path === o.href }]}>
						{o.label}
					</a>
				))
			}
		</div>
		<a href="/about" class:list={[{ current: path === '/about' }]}>About</a>
	</nav>
</header>

<script>
	const btn = document.querySelector('.menu-btn');
	const nav = document.querySelector('.site-nav');
	const setOpen = (open: boolean) => {
		nav?.classList.toggle('open', open);
		btn?.setAttribute('aria-expanded', String(open));
	};
	btn?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
	document.addEventListener('click', (e) => {
		const t = e.target as Node;
		if (btn?.contains(t) || nav?.contains(t)) return;
		setOpen(false);
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setOpen(false);
	});
</script>

<style>
	.site-header {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 20px;
		background: #fcf9f1;
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
		z-index: 30;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
	}
	.logo-text {
		font-family: 'Playfair Display', serif;
		font-weight: 700;
		font-size: 1.6rem;
		color: #1a1a1a;
	}
	.hub {
		color: #d4a276;
	}
	.menu-btn {
		display: flex;
		flex-direction: column;
		gap: 6px;
		background: none;
		border: none;
		padding: 6px;
		cursor: pointer;
	}
	.menu-btn span {
		display: block;
		width: 28px;
		height: 2px;
		background: #1a1a1a;
	}

	/* Menu panel: full width on mobile */
	.site-nav {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: #fcf9f1;
		padding: 10px 20px 18px;
		box-shadow: 0 10px 18px rgba(0, 0, 0, 0.06);
	}
	.site-nav.open {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.site-nav a {
		padding: 10px 0;
		text-decoration: none;
		color: #1a1a1a;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
	}
	.site-nav a.current {
		color: #d4a276;
	}
	.nav-group {
		margin: 6px 0 0;
		padding: 10px 0 2px;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
		color: #1a1a1a;
	}
	.nav-sub {
		display: flex;
		flex-direction: column;
		margin: 0 0 4px 4px;
		padding-left: 12px;
		border-left: 2px solid #d4a276;
	}
	.nav-sub a {
		padding: 8px 0;
		font-size: 14px;
		font-weight: 400;
	}

	/* Laptop: same toggle, the menu opens as a small card on the right */
	@media (min-width: 800px) {
		.site-header {
			padding: 18px 60px;
		}
		.site-nav {
			left: auto;
			right: 60px;
			top: calc(100% + 8px);
			width: 270px;
			background: #ffffff;
			border-radius: 14px;
			box-shadow: 0 12px 30px rgba(0, 0, 0, 0.14);
			padding: 8px 20px 12px;
		}
	}
</style>
