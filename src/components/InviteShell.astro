---
import { haya } from '../data/templates/haya';
import { hayaEnvelope, hayaDemoInvitation } from '../data/haya-envelope';

// The engine reads this block: the look (design), the card layout (template) and the guest's details (invitation).
const config = {
	design: hayaEnvelope,
	template: haya,
	invitation: hayaDemoInvitation,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex" />
		<title>Invitation</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Berkshire+Swash&family=Unna:ital,wght@0,400;0,700;1,600&family=Playfair+Display:wght@700&family=Pinyon+Script&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/envelope.css?v=26" />
		<link rel="stylesheet" href="/ih-footer.css?v=6" />
		<link rel="preload" as="image" href="/haya-tray-m.webp" media="(max-width: 699px), (orientation: portrait)" />
		<link rel="preload" as="image" href="/haya-tray.webp" media="(min-width: 700px) and (orientation: landscape)" />
		<link rel="preload" as="image" href="/haya3-closed.webp?v=2" />
		<link rel="preload" as="image" href="/haya3-body.webp" />
		<link rel="preload" as="image" href="/haya-bg.jpg?v=4" media="(max-width: 699px), (orientation: portrait)" />
	</head>
	<body>
		<div id="env-root"></div>
		<script is:inline id="env-config" type="application/json" set:html={JSON.stringify(config)} />
		<p id="inv-msg" style="display:none;font-family:Poppins,sans-serif;text-align:center;padding:40px 20px;color:#5a5a5a"></p>
		<script is:inline>
			// Loads this guest's invitation from the saved order, then starts the envelope
			(function () {
				var q = new URLSearchParams(location.search);
				var el = document.getElementById('env-config');
				var msg = document.getElementById('inv-msg');
				function fail(t) {
					msg.textContent = t;
					msg.style.display = 'block';
				}
				function load(src, cb) {
					var s = document.createElement('script');
					s.src = src;
					s.onload = cb;
					document.body.appendChild(s);
				}
				// New links: /inviteheaven/<couple>/guest=<name>  or  /inviteheaven/<couple>/group=<group>  or  /inviteheaven/<couple>
				// Older links: /i?p=...&g=...
				var qs;
				var parts = location.pathname.split('/').filter(Boolean);
				if (parts.length >= 2 && parts[0] !== 'i') {
					var qq = new URLSearchParams();
					qq.set('c', decodeURIComponent(parts[1]));
					var who = parts[2] ? decodeURIComponent(parts.slice(2).join('/')) : '';
					if (who.indexOf('guest=') === 0) qq.set('g', who.slice(6));
					else if (who.indexOf('group=') === 0) qq.set('l', who.slice(6));
					qs = qq.toString();
				} else qs = q.toString().replace(/&?v=\d+/, '');
				fetch('/api/invite?' + qs)
					.then(function (r) {
						if (r.status === 410) throw new Error('expired');
						if (!r.ok) throw new Error('x');
						return r.json();
					})
					.then(function (d) {
						var cfg = JSON.parse(el.textContent);
						cfg.invitation = { couple: d.couple, events: d.events, hosts: d.hosts || [], guest: d.guest || '', musicSrc: d.musicSrc || '', seats: d.seats || 0, seatRows: d.seatRows || [], footer: d.footer || { mode: 'couple', family: '' } };
						el.textContent = JSON.stringify(cfg);
						document.title = d.couple.groomName.split(' ')[0] + ' & ' + d.couple.brideName.split(' ')[0] + ' | Invitation';
						load('/ih-footer.js?v=5', function () {
							load('/gsap.min.js', function () {
								load('/envelope-engine.js?v=37');
							});
						});
					})
					.catch(function (e) {
						if (e && e.message === 'expired') return fail('This invitation has expired. Invitation links stay live for 3 months. Please contact the couple.');
						fail('This invitation link is not available. Please check the link you received.');
					});
			})();
		</script>
	</body>
</html>
