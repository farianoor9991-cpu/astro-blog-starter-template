---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Ticker from '../components/Ticker.astro';

interface Props {
	title: string;
	description?: string;
	ticker?: string[];
}
const {
	title,
	description = 'Elegant digital invitations for weddings and celebrations.',
	ticker,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Invite Heaven`} description={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		{ticker && <Ticker items={ticker} />}
		<SiteHeader />
		<main class="page-main">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

<style is:global>
	body {
		background: #fcf9f1 !important;
		margin: 0;
		padding: 0;
		font-family: 'Poppins', sans-serif;
		color: #5a5a5a;
		font-size: 16px;
		overflow-x: hidden;
	}
</style>

<style>
	.page-main {
		width: 100%;
		max-width: 1100px;
		min-height: 50vh;
		margin: 0 auto;
		padding: 56px 20px 80px;
		box-sizing: border-box;
	}
</style>
