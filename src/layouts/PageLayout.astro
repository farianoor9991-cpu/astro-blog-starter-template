---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Ticker from '../components/Ticker.astro';

interface Props {
	title: string;
	description?: string;
	ticker?: string[];
	section?: 'websites' | 'ecards';
	variant?: 'default' | 'home';
}
const {
	title,
	description = 'Elegant digital invitations for weddings and celebrations.',
	ticker,
	section = 'websites',
	variant = 'default',
} = Astro.props;
// "home" variant (homepage and E-Cards page): the title is used exactly as given
const fullTitle = variant === 'home' ? title : `${title} | Invite Heaven`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={fullTitle} description={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		{ticker && <Ticker items={ticker} />}
		<SiteHeader section={section} />
		<main class:list={['page-main', { home: variant === 'home' }]}>
			<slot />
		</main>
		<SiteFooter section={section} />
	</body>
</html>

<style is:global>
	body {
		background: #fcf9f1 !important;
		margin: 0;
		padding: 0;
		font-family: 'Poppins', sans-serif;
		color: #5a5a5a;
		font-size: 16px;
		overflow-x: hidden;
	}
</style>

<style>
	.page-main {
		width: 100%;
		max-width: 1100px;
		min-height: 50vh;
		margin: 0 auto;
		padding: 56px 20px 80px;
		box-sizing: border-box;
	}
	/* Homepage settings */
	.page-main.home {
		max-width: 1200px;
		min-height: 0;
		padding: 0 20px 40px;
	}
	@media (min-width: 800px) {
		.page-main.home {
			padding: 20px 60px 80px;
		}
	}
</style>
